  Node4 [id="Node000004",label="PDF Visualization of AST",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__PDFGenerationStuff.html",tooltip="This class defines the PDF output of the AST."];
  Node2 [id="Node000002",label="ROSE 3rd Party Libraries",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__ROSE__3rdPartyLibrariesGroup.html",tooltip="A number of independent libraries used in ROSE."];
