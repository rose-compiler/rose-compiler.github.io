        <references refid="classSawyer_1_1MultiInstanceTls_1ae0b304fdd1e9159fbc9c05ac708325cc" compoundref="Synchronization_8h" startline="198">Sawyer::MultiInstanceTls&lt; T &gt;::repo_</references>
