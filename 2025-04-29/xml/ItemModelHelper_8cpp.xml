<parameteritem>
<parameternamelist>
<parametername>column</parametername>
</parameternamelist>
<parameterdescription>
<para>from which column the compare-value should be fetched (most models return the same SgNode regardless of the column number) </para></parameterdescription>
</parameteritem>
</parameterlist>
</para>        </detaileddescription>
