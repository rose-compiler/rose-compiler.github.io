        <type>void</type>
        <definition>void doFiniteDifferencingOne</definition>
        <argsstring>(SgExpression *e, SgBasicBlock *root, RewriteRule *rules)</argsstring>
        <name>doFiniteDifferencingOne</name>
        <param>
          <type>SgExpression *</type>
          <declname>e</declname>
        </param>
        <param>
