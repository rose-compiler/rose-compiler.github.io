      <memberdef kind="function" id="classSawyer_1_1Container_1_1DenseIntegerSet_1_1ConstIterator_1aa71cfc86a75153b80466feb1f2d8f4e4" prot="public" static="no" const="yes" explicit="no" inline="yes" virt="non-virtual">
