      <memberdef kind="function" id="classSgAsmScalarType_1a62c30cf538dfa2961e4ba7b1a55c6287" prot="public" static="no" const="yes" explicit="no" inline="no" virt="virtual">
        <type>void</type>
        <definition>virtual void SgAsmScalarType::check</definition>
        <argsstring>() const override</argsstring>
        <name>check</name>
        <reimplements refid="classSgAsmType_1abb69f0f34b42d59c15292dba7bbdcc51">check</reimplements>
        <reimplementedby refid="classSgAsmPointerType_1a88ddfbcb51c20ab601d8f77c82339faf">check</reimplementedby>
        <reimplementedby refid="classSgAsmIntegerType_1ad014d017c9ad07430eb8be75d2879145">check</reimplementedby>
        <reimplementedby refid="classSgAsmFloatType_1a5231ae229fb347bd0c13d3788ddb7b7d">check</reimplementedby>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Validate properties collectively.</para><para>This method collectively validates the properties of a type since validation is not always possible or convenient when the user modifies an individual property. For instance, when changing the bit fields in a floating-point type, it would be very inconvenient to the user if those properties individually validated there settings because it would require the user to shuffle fields around in such a way that they never overlap. This way, the overlap validation can occur after the user is all done moving the fields. </para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/home/liao6/workspace/rose-github/src/AstNodes/BinaryAnalysis/SgAsmScalarType.h" line="43" column="1"/>
      </memberdef>
