      <memberdef kind="function" id="classSawyer_1_1Tree_1_1Vertex_1aaf2e142b923923901916c790c271f2b1" prot="public" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
        <templateparamlist>
          <param>
            <type>class <ref refid="NEW__ControlDependenceGraph_8C_1af40713911bb5d86f82a7057cc45a65ff" kindref="member">T</ref></type>
