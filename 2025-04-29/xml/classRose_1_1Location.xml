        <definition>virtual bool Rose::Location::isEqual</definition>
        <argsstring>(const Location &amp;other) const =0</argsstring>
        <name>isEqual</name>
        <reimplementedby refid="classRose_1_1SourceLocation_1a46e85510c9a30d5d292627b161aaaa48">isEqual</reimplementedby>
