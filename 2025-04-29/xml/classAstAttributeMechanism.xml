        <references refid="SgAsmPESectionTableEntry_8h_1aaf1bd07e95aeff0f585394fccaf479ab" compoundref="SgAsmPESectionTableEntry_8h" startline="21">name</references>
      </memberdef>
      <memberdef kind="function" id="classAstAttributeMechanism_1a4915a80d22045e3697e6e3c107530a5e" prot="public" static="no" const="no" explicit="no" inline="no" virt="non-virtual">
        <type>void</type>
        <definition>void AstAttributeMechanism::remove</definition>
        <argsstring>(const std::string &amp;name)</argsstring>
        <name>remove</name>
        <param>
          <type>const std::string &amp;</type>
          <declname>name</declname>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Erases the specified attribute.</para><para>If an attribute with the specified name exists then it is removed from the container. If the attribute implements the <ref refid="classAstAttribute_1ab82a227fa3befab83ec49a8bc64d8884aee6f0ddaa9ca9fe05aabf769e617d959" kindref="member">AstAttribute::CONTAINER_OWNERSHIP</ref> policy then this container deletes the attribute, otherwise it is up to the attribute&apos;s designer to implement a safe way to prevent attribute leaks, and the attribute must not be deleted until after this method returns.</para><para><bold>New semantics:</bold> The old implementation did not delete the attribute value. It also printed an error message to standard error if the attribute did not exist. </para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/home/liao6/workspace/rose-github/src/midend/astProcessing/AstAttributeMechanism.h" line="369" column="1" bodyfile="/home/liao6/workspace/rose-github/src/midend/astProcessing/AstAttributeMechanism.C" bodystart="160" bodyend="167"/>
