      <memberdef kind="function" id="classRangeMapVoid_1a76bf0e4a997c100cbf6b216f2426b6c2" prot="public" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
        <type>void</type>
        <definition>void RangeMapVoid&lt; R &gt;::truncate</definition>
        <argsstring>(const Range &amp;, const typename Range::Value &amp;)</argsstring>
        <name>truncate</name>
        <param>
          <type>const <ref refid="classRangeMapVoid_1a08a8e7fccb1e5179e0dc22dddbdc02b1" kindref="member">Range</ref> &amp;</type>
        </param>
        <param>
          <type>const typename <ref refid="classRange_1a0110e09e84e56cb5b63bc5bde2a2a241" kindref="member">Range::Value</ref> &amp;</type>
        </param>
        <briefdescription>
        </briefdescription>
        <detaileddescription>
<para>Truncate the <ref refid="classRangeMap" kindref="compound">RangeMap</ref> value. This is similar to the <ref refid="classRangeMapVoid_1a116c0f33a71b7afd47ac84e013ee8754" kindref="member">removing()</ref> method, but only discards part of the value. The <computeroutput>new_end</computeroutput> argument is the first value past the end of this range and must be such that the range would not become larger. </para>        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/home/liao6/workspace/rose-github/src/roseSupport/rangemap.h" line="564" column="1" bodyfile="/home/liao6/workspace/rose-github/src/roseSupport/rangemap.h" bodystart="564" bodyend="565"/>
