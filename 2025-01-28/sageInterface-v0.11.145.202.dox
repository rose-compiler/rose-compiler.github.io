/**
 * @fn bool SageInterface::isStructurallyEquivalentAST(SgNode* tree1, SgNode* tree2)
 *
 * @brief Checks if two Abstract Syntax Trees (ASTs) are structurally equivalent.
 *
 * This function compares the structure of two ASTs by iterating through their nodes
 * and checking for equivalence. It uses ROSE's AST iterator to traverse both trees
 * simultaneously and verify that they have the same structure.
 *
 * @param tree1 The first AST to compare.
 * @param tree2 The second AST to compare.
 *
 * @return True if the two ASTs are structurally equivalent, false otherwise.
 *
 * @warning This function assumes that the input ASTs are valid and well-formed.
 * If the input ASTs are not valid or well-formed, the behavior of this function is undefined.
 *
 * @pre The input ASTs must be non-null and must have been created using ROSE's AST builder.
 *
 * @post If the function returns true, it means that the two input ASTs are structurally equivalent.
 * If the function returns false, it means that the two input ASTs are not structurally equivalent.
 *
 * @note This function uses a recursive algorithm to compare the ASTs. It may cause a stack overflow if the input ASTs are very large.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* tree1 = ...; // create first AST
 *           SgNode* tree2 = ...; // create second AST
 *           bool result = SageInterface::isStructurallyEquivalentAST(tree1, tree2);
 *           if (result) {
 *               printf("The two ASTs are structurally equivalent.\n");
 *           } else {
 *               printf("The two ASTs are not structurally equivalent.\n");
 *           }
 *          @endcode
 */
/**
 * @fn SageInterface::evaluateConstIntegerExpression(SgExpression *expr)
 *
 * @brief Evaluates a constant integer expression using the SimpleExpressionEvaluator.
 *
 * This function uses the SimpleExpressionEvaluator to traverse the given SgExpression
 * and evaluate it as a constant integer. The result of this evaluation is then returned.
 *
 * @param expr The SgExpression representing the constant integer expression to be evaluated.
 *             Must be a valid SgExpression, otherwise undefined behavior may occur.
 *
 * @return The result of evaluating the given constant integer expression as an integer value.
 *
 * @warning This function assumes that the input expression is a valid constant integer
 *          expression. If this assumption does not hold, the returned result may be incorrect.
 *
 * @pre The input SgExpression must be valid and represent a constant integer expression.
 *
 * @post The returned result represents the evaluated value of the given constant integer expression.
 *
 * @note This function uses the SimpleExpressionEvaluator to perform the evaluation. Therefore,
 *       any limitations or assumptions made by this evaluator also apply to this function.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgExpression *expr = ...; // Initialize expr with a constant integer expression
 *           int result = SageInterface::evaluateConstIntegerExpression(expr);
 *           std::cout << "The evaluated result is: " << result << std::endl;
 *          @endcode
 */
/**
 * @fn string SageInterface::getTempDirectory(SgProject *project)
 *
 * @brief Retrieves a temporary directory for a given project.
 *
 * This function obtains a temporary directory from the Java environment and
 * returns it as a string. The retrieved directory is also appended to the
 * project's Java source path with lower priority.
 *
 * @param project A pointer to an SgProject object representing the project for which the temporary directory is needed.
 *                 Must be non-null.
 *
 * @return The name of the temporary directory as a string.
 *
 * @warning The returned directory may not exist or may have been deleted after this function returns. It's the caller's responsibility to check its existence before use.
 *
 * @pre The project pointer must be valid and non-null.
 *
 * @post The retrieved directory is appended to the project's Java source path, but its existence is not guaranteed.
 *
 * @note This function relies on the Java environment being properly set up and configured. If the Java environment is not available or is malfunctioning, this function may return an empty string or throw an exception.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject* project = ...; // assume a valid project object
 *           SageInterface sage;
 *           string tempDir = sage.getTempDirectory(project);
 *           if (!tempDir.empty()) {
 *               cout << "Temporary directory: " << tempDir << endl;
 *           } else {
 *               cerr << "Failed to retrieve temporary directory." << endl;
 *           }
 *          @endcode
 */
/**
 * @fn void SageInterface::destroyTempDirectory(string directory_name)
 *
 * @brief Destroys a temporary directory.
 *
 * This function permanently deletes a specified temporary directory and all of its contents. It utilizes the system's command-line interface to execute a removal command.
 *
 * The function first constructs a command string by concatenating the "rm -fr" command with the provided directory name. Then, it executes this command using the system() function and checks the returned status code to ensure successful execution. If the status code is non-zero, an assertion failure occurs.
 *
 * @param directory_name The name of the temporary directory to be destroyed. Must be a valid directory path.
 *
 * @return None
 *
 * @warning This function permanently deletes files without prompting for confirmation. Use with caution.
 *
 * @pre The provided directory name must exist and be accessible by the current user.
 *
 * @post The specified directory and all of its contents are deleted from the file system.
 *
 * @note This function uses the system() function to execute a command, which may pose security risks if used with untrusted input. Ensure that the provided directory name is properly sanitized before calling this function.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SageInterface sage;
 *           string tempDir = "/path/to/temp/directory";
 *           // Create a temporary directory (implementation omitted)
 *           sage.destroyTempDirectory(tempDir);
 *          @endcode
 */
/**
 * @fn SgFile* SageInterface::processFile(SgProject *project, string filename, bool unparse /* = false */)
 *
 * @brief Processes a source file using the ROSE compiler infrastructure.
 *
 * This function takes a project, a filename, and an optional unparsing flag as input. 
 * It sets up the new source file for processing "a la Rose", determines the file type, 
 * inserts the file into the list of files in the project, builds the Java Abstract Syntax Tree (AST), 
 * and returns the processed SgFile.
 *
 * @param project The SgProject instance that contains the file to be processed.
 * @param filename The name of the source file to be processed.
 * @param unparse If true, the function will not perform any parsing or analysis on the file. Defaults to false.
 *
 * @return A pointer to the processed SgFile instance.
 *
 * @warning This function assumes that the input project and filename are valid. 
 *          It does not perform any error checking on these parameters.
 *
 * @pre The project instance must be properly initialized before calling this function.
 *      The filename must exist in the file system and be a valid source file.
 *
 * @post The processed SgFile instance is returned, and the project's file list is updated accordingly.
 *
 * @note This function uses various ROSE infrastructure components, including the CommandlineProcessing class 
 *       and the determineFileType function. It also relies on the Java AST builder to construct the AST for the input file.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject project;
 *           string filename = "example.java";
 *           SgFile* processed_file = SageInterface::processFile(&project, filename);
 *           // Use the processed_file pointer as needed...
 *          @endcode
 */
/**
 * @fn string SageInterface::preprocessPackage(SgProject *project, string package_name)
 *
 * @brief Preprocesses a Java package by creating a temporary file with the relevant package statement.
 *
 * This function takes a Sage project and a package name as input, creates a temporary file containing the package statement,
 * translates the file using the processFile() function, and returns the original package name.
 *
 * The function uses the Java Native Interface (JNI) to call the Ecj class's createTempFile method, which generates a temporary file
 * with the given package statement. It then retrieves the filename from the jstring object returned by the JNI call,
 * translates the file using processFile(), and returns the original package name.
 *
 * @param project The Sage project containing the Java code to be translated.
 * @param package_name The name of the Java package to be preprocessed.
 *
 * @return The original package name passed as input to the function.
 *
 * @warning This function assumes that the Ecj class and its createTempFile method are available through the Java Native Interface (JNI).
 *          It also assumes that the processFile() function is implemented correctly to translate the generated temporary file.
 *
 * @pre The Sage project and package name must be valid and properly initialized before calling this function.
 *
 * @post The function returns the original package name, and the temporary file containing the package statement has been translated using processFile().
 *
 * @note This function uses JNI calls to interact with the Java environment, which may have performance implications.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject* project = ...; // initialize a Sage project
 *           string package_name = "myPackage"; // specify the package name
 *           string result = preprocessPackage(project, package_name);
 *           cout << "Preprocessed package: " << result << endl;
 *          @endcode
 */
/**
 * @fn string SageInterface::preprocessImport(SgProject *project, string import_string)
 *
 * @brief Preprocesses an import statement by creating a temporary file with the relevant import statement.
 *
 * This function takes an import statement as input and preprocesses it by
 * creating a temporary file containing the import statement. It then calls
 * another function to translate this temporary file.
 *
 * The purpose of this preprocessing step is to facilitate the translation
 * process, possibly by allowing for easier parsing or analysis of the import
 * statement.
 *
 * @param project A pointer to an SgProject object representing the current project.
 * @param import_string The import statement to be preprocessed as a string.
 *
 * @return The original import statement, unmodified.
 *
 * @warning This function assumes that the input import statement is valid and
 *          well-formed. If this assumption does not hold, undefined behavior may occur.
 *
 * @pre The project pointer must be non-null and point to a valid SgProject object.
 *
 * @post The temporary file created by this function will be deleted after it has
 *       been translated.
 *
 * @note This function uses the Java Native Interface (JNI) to interact with the Java side of the ROSE compiler infrastructure.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject* project = ...; // obtain a valid SgProject object
 *           string import_string = "java.lang.Math"; // define an import statement
 *           SageInterface sage;
 *           string preprocessed_import = sage.preprocessImport(project, import_string);
 *          @endcode
 */
/**
 * @fn SgFile* SageInterface::preprocessCompilationUnit(SgProject *project, string file_name, string file_content, bool unparse)
 *
 * @brief Preprocesses a compilation unit by creating an input file with relevant import statements.
 *
 * This function preprocesses a compilation unit by calling the Java side to create an input file
 * with the relevant import statement. It then translates the file and unparses it if requested.
 *
 * The function uses the ROSE framework's Frontend Java Ecj class to interact with the Java environment.
 * The result of the preprocessing is returned as a Sage File object.
 *
 * @param project The SgProject object representing the project being compiled.
 * @param file_name The name of the file being preprocessed.
 * @param file_content The content of the file being preprocessed.
 * @param unparse A boolean indicating whether to unparse the file after translation. Defaults to true.
 *
 * @return A Sage File object representing the preprocessed compilation unit.
 *
 * @warning This function may throw an exception if there is a problem interacting with the Java environment.
 *
 * @pre The project, file_name, and file_content parameters must not be null or empty.
 *
 * @post The returned SgFile object will represent the preprocessed compilation unit.
 *
 * @note This function uses the ROSE framework's Frontend Java Ecj class to interact with the Java environment.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject* project = ...; // create a Sage project object
 *           string file_name = "example.java";
 *           string file_content = "public class Example { }";
 *           bool unparse = true;
 *           
 *           SgFile* preprocessed_file = SageInterface::preprocessCompilationUnit(project, file_name, file_content, unparse);
 *          @endcode
 */
/**
 * @fn SgClassDefinition* SageInterface::findJavaPackage(SgScopeStatement* scope, string package_name)
 *
 * @brief Finds a Java package declaration within a given scope.
 *
 * This function searches for a Java package declaration within the provided scope,
 * using the specified package name. It iterates through the package name, splitting
 * it into individual components and searching for each component in the current scope.
 *
 * The search is performed recursively, with each successful match updating the current
 * scope to the definition of the matched package. If any component of the package name
 * is not found within the current scope, the function returns NULL.
 *
 * @param scope The scope within which to search for the Java package declaration.
 *              Must be non-NULL and a valid SgScopeStatement pointer.
 *
 * @param package_name The fully qualified name of the Java package to find.
 *                      Must be a non-empty string and a valid Java package name.
 *
 * @return A pointer to the SgClassDefinition representing the found Java package declaration,
 *         or NULL if the package is not found within the provided scope.
 *
 * @warning This function may return NULL if the package name is invalid or if the
 *          package declaration is not found within the provided scope.
 *
 * @pre The input scope must be non-NULL and a valid SgScopeStatement pointer.
 *
 * @post If the function returns a non-NULL value, it will point to a valid SgClassDefinition
 *       representing the found Java package declaration.
 *
 * @note This function uses a recursive algorithm to search for the package declaration,
 *       which may lead to performance issues for deeply nested packages.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgScopeStatement* scope = ...; // obtain a valid scope statement
 *           string package_name = "java.lang"; // specify the package name
 *           SgClassDefinition* package_definition = SageInterface::findJavaPackage(scope, package_name);
 *           if (package_definition != NULL) {
 *               // process the found package definition
 *           } else {
 *               // handle the case where the package is not found
 *           }
 *          @endcode
 */
/**
 * @fn SgClassDefinition *SageInterface::findOrInsertJavaPackage(SgProject *project, string package_name, bool create_directory /* = false */)
 *
 * @brief Finds or inserts a Java package in the given project.
 *
 * This function searches for a Java package with the specified name in the given project. If the package is not found, it attempts to load the package and then search again. If requested, it also creates the directory associated with this package.
 *
 * The function uses the SageInterface's global scope to find the package definition. If the package is not found after loading, a new package definition is created.
 *
 * @param project The SgProject object in which to search for the Java package.
 * @param package_name The name of the Java package to search for or insert.
 * @param create_directory Optional parameter indicating whether to create the directory associated with this package. Defaults to false.
 *
 * @return A pointer to the SgClassDefinition object representing the found or inserted Java package, or NULL if the package could not be found or created.
 *
 * @warning If the create_directory parameter is true, the function will attempt to create a directory on disk. This may fail if the directory already exists or if there are permissions issues.
 *
 * @pre The project object must be valid and non-NULL.
 * @post The returned package definition object is valid and non-NULL if the package was found or created successfully.
 *
 * @note This function modifies the global scope of the SageInterface by loading new packages if necessary.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject* project = ...; // obtain a valid SgProject object
 *           string package_name = "my.package";
 *           bool create_directory = true;
 *           SgClassDefinition* package_definition = findOrInsertJavaPackage(project, package_name, create_directory);
 *           if (package_definition != NULL) {
 *               cout << "Found or inserted package: " << package_definition->get_name() << endl;
 *           } else {
 *               cerr << "Error finding or creating package" << endl;
 *           }
 *          @endcode
 */
/**
 * @fn SgClassDeclaration *SageInterface::findOrImportJavaClass(SgProject *project, SgClassDefinition *package_definition, string class_name)
 *
 * @brief Finds or imports a Java class declaration from a given package definition.
 *
 * This function searches for a Java class declaration in the given package definition. If the class is not found,
 * it attempts to import it using the preprocessImport() function. The search is performed by looking up the class
 * symbol and checking if its declaration is an SgClassDeclaration. If the class is not available in the current scope,
 * the function pre-processes the import statement for the qualified name of the class.
 *
 * @param project The Sage project to work with.
 * @param package_definition The package definition that contains the Java class to be found or imported.
 * @param class_name The name of the Java class to find or import.
 *
 * @return A pointer to the SgClassDeclaration if found, otherwise NULL. If the class is not available in the current
 *         scope and cannot be imported, the function returns NULL.
 *
 * @warning This function assumes that the package definition is valid and contains the necessary information for
 *          importing Java classes.
 *
 * @pre The project and package_definition parameters must be non-NULL. The class_name parameter must be a valid string.
 *
 * @post If the function returns a non-NULL pointer, it guarantees that the returned SgClassDeclaration is complete
 *       (i.e., has the "complete" attribute).
 *
 * @note This function uses the preprocessImport() function to import Java classes. The implementation of this function
 *       is not shown here.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject project = ...; // assume a valid Sage project
 *           SgClassDefinition package_definition = ...; // assume a valid package definition
 *           string class_name = "MyJavaClass";
 *           SgClassDeclaration* class_declaration = findOrImportJavaClass(project, package_definition, class_name);
 *           if (class_declaration != NULL) {
 *               // use the found or imported class declaration
 *           } else {
 *               // handle the case where the class cannot be found or imported
 *           }
 *          @endcode
 */
/**
 * @fn SgClassDeclaration *SageInterface::findOrImportJavaClass(SgProject *project, string package_name, string class_name)
 *
 * @brief Finds or imports a Java class in the given project.
 *
 * This function searches for a Java class with the specified name within the
 * provided project. If the class is found, it returns a pointer to the SgClassDeclaration
 * representing the class. If not found, it attempts to import the class from the
 * specified package and then returns the corresponding SgClassDeclaration.
 *
 * The function relies on the findOrInsertJavaPackage() method to locate or create
 * the Java package with the given name in the project. It then proceeds to search for
 * the class within this package.
 *
 * @param project     The Sage project in which to search for the Java class.
 * @param package_name The fully qualified name of the Java package containing the class.
 * @param class_name   The simple name of the Java class to find or import.
 *
 * @return A pointer to the SgClassDeclaration representing the found or imported Java class,
 *         or NULL if the class could not be found or imported.
 *
 * @warning If the project, package, or class names are invalid or do not follow
 *          the expected format, the function's behavior is undefined.
 *
 * @pre The provided project and package name must be valid and correctly formatted.
 *      The class name must also be a valid Java identifier.
 *
 * @post If the class is found or imported successfully, the returned SgClassDeclaration
 *       will point to a valid object representing the class. Otherwise, NULL will be returned.
 *
 * @note This function does not perform any error checking on the input parameters.
 *       It assumes that the project and package names are correctly formatted and
 *       that the class name is a valid Java identifier.
 *
 * @example Here's an example of how to use this function:
 *          @code
 *           SgProject* project = ...; // assuming a valid Sage project
 *           string packageName = "com.example.myproject";
 *           string className = "MyJavaClass";
 *           SgClassDeclaration* javaClass = findOrImportJavaClass(project, packageName, className);
 *           if (javaClass != NULL) {
 *               // use the found or imported Java class
 *           } else {
 *               // handle the case where the class could not be found or imported
 *           }
 *          @endcode
 */
/**
 * @fn SgClassDeclaration* SageInterface::findOrImportJavaClass(SgProject* project, SgClassType* class_type)
 *
 * @brief Finds or imports a Java class declaration from the given project.
 *
 * This function searches for a Java class declaration in the given project based
 * on the provided SgClassType object. If the class is found, it returns the
 * corresponding SgClassDeclaration pointer; otherwise, it attempts to import
 * the class and returns the resulting SgClassDeclaration pointer.
 *
 * The search process involves traversing up the scope hierarchy from the given
 * SgClassType object until a Java package declaration is encountered. If no such
 * declaration is found (i.e., a local type), the function returns NULL.
 *
 * @param project The SgProject object representing the compilation unit to search for the class declaration.
 * @param class_type The SgClassType object providing information about the class to find or import.
 *
 * @return A pointer to the found or imported SgClassDeclaration, or NULL if the class is a local type.
 *
 * @warning If the given project or class_type parameter is invalid, undefined behavior may occur.
 *
 * @pre The provided project and class_type parameters must be valid and non-null.
 *
 * @post The returned SgClassDeclaration pointer (if not NULL) points to a valid Java class declaration.
 *
 * @note This function assumes that the given SgClassType object has a defining declaration that can be used as a starting point for the search process.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create an instance of SageInterface and a sample project
 *           SageInterface sage;
 *           SgProject* project = ...;  // Initialize project object
 *
 *           // Define a sample class type
 *           SgClassType* class_type = ...;  // Initialize class_type object
 *
 *           // Find or import the Java class declaration
 *           SgClassDeclaration* class_declaration = sage.findOrImportJavaClass(project, class_type);
 *
 *           // Use the found or imported class declaration as needed
 *          @endcode
 */
/**
 * @fn SgMemberFunctionDeclaration *SageInterface::findJavaMain(SgClassDefinition *class_definition)
 *
 * @brief Finds a Java main method within a given class definition.
 *
 * This function searches for a Java main method, which is a method with the signature
 * public static void main(String[] args), within a provided class definition. The search
 * is performed by looking up a function symbol with the name "main" and the specified
 * member function type in the given class definition.
 *
 * @param class_definition The class definition to be searched for the Java main method.
 *                          Must not be NULL.
 *
 * @return A pointer to the SgMemberFunctionDeclaration representing the found Java main method,
 *         or NULL if no such method is found.
 *
 * @warning This function assumes that the provided class definition is valid and well-formed.
 *          If the input class definition is invalid, the behavior of this function is undefined.
 *
 * @pre The class_definition pointer must not be NULL.
 *
 * @post If a Java main method is found, the returned pointer will point to a valid SgMemberFunctionDeclaration
 *       representing that method. Otherwise, the returned value will be NULL.
 *
 * @note This function uses the SageBuilder to construct an SgFunctionType representing the type of the Java main method,
 *       and then looks up a function symbol with that type in the provided class definition.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgClassDefinition* class_definition = ...; // obtain a class definition somehow
 *           SgMemberFunctionDeclaration* main_method = SageInterface::findJavaMain(class_definition);
 *           if (main_method != NULL) {
 *               // found the Java main method, do something with it...
 *           } else {
 *               // no Java main method found in this class definition...
 *           }
 *          @endcode
 */
/**
 * @fn SgMemberFunctionDeclaration *SageInterface::findJavaMain(SgClassType *class_type)
 *
 * @brief Finds the Java main method within a given class type.
 *
 * This function searches for the Java main method within a provided class type using
 * the Sage compiler's internal representation of the class declaration and definition.
 * It utilizes the ROSE library's Abstract Syntax Tree (AST) to navigate and query the
 * class structure, ultimately returning a pointer to the SgMemberFunctionDeclaration
 * representing the main method if found.
 *
 * @param class_type The SgClassType object containing the Java class for which to find the main method.
 *                    Must be a valid, non-null pointer to an SgClassType instance.
 *
 * @return A pointer to the SgMemberFunctionDeclaration representing the Java main method,
 *         or null if no such method is found within the provided class type.
 *
 * @warning This function assumes that the input class_type has been properly initialized
 *          and validated prior to its invocation. Failure to ensure this may result in
 *          undefined behavior or runtime errors.
 *
 * @pre The input class_type must be a valid, non-null pointer to an SgClassType instance.
 *      The class declaration associated with the input class_type must have a well-formed definition.
 *
 * @post If the main method is found within the provided class type, the returned
 *       SgMemberFunctionDeclaration will point to a valid, initialized object.
 *
 * @note This function utilizes internal implementation details of the Sage compiler and ROSE library,
 *       and as such may be subject to change or revision in future releases.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgClassType *my_class_type = ...; // assume initialization and validation
 *           SgMemberFunctionDeclaration *main_method = SageInterface::findJavaMain(my_class_type);
 *           if (main_method != NULL) {
 *               // process the main method declaration as needed
 *           }
 *          @endcode
 */
/**
 * @fn bool isTemplateInstantiationFromTemplateDeclarationSatisfyingFilter(SgFunctionDeclaration* function, T* filter)
 *
 * @brief Checks if a given SgFunctionDeclaration represents a template instantiation that satisfies a user-defined filter.
 *
 * This function determines whether the input SgFunctionDeclaration is a template instantiation and 
 * checks if its template declaration satisfies the condition specified by the provided filter. 
 * The check involves recursively traversing the declaration tree to find the original template declaration, 
 * which may be hidden due to EDG normalization. If the original template declaration is found, 
 * the function applies the user-defined filter to it and returns true if the filter condition is met.
 *
 * @param function A pointer to an SgFunctionDeclaration object representing a function in the abstract syntax tree (AST).
 * @param filter A pointer to an object of type T that defines the filter condition. The object must overload the operator() 
 *                to apply the filter condition to an SgTemplateFunctionDeclaration or SgTemplateMemberFunctionDeclaration object.
 *
 * @return True if the input function declaration represents a template instantiation and its original template declaration satisfies the filter condition; false otherwise.
 *
 * @warning This function assumes that the input function declaration is valid and well-formed. If the input is invalid, 
 *          the behavior of this function is undefined.
 *
 * @pre The input function declaration must be non-null and represent a valid SgFunctionDeclaration object in the AST.
 * @post None
 *
 * @note This function is designed to handle cases where EDG normalization has modified the original template declarations. 
 *       It recursively traverses the declaration tree to find the original template declaration, which may be hidden due to EDG normalization.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgFunctionDeclaration* funcDecl = ...; // obtain a valid SgFunctionDeclaration object
 *           MyFilter filter; // define an instance of the filter class
 *           bool result = isTemplateInstantiationFromTemplateDeclarationSatisfyingFilter(funcDecl, &filter);
 *           if (result) {
 *               // The template instantiation satisfies the filter condition.
 *           } else {
 *               // The template instantiation does not satisfy the filter condition.
 *           }
 *          @endcode
 */
/**
 * @fn void SageInterface::detectCycleInType(SgType * type, const std::string & from)
 *
 * @brief Detects a cycle in the type hierarchy starting from the given type.
 *
 * This function traverses the type hierarchy upwards to detect cycles. It uses
 * a recursive approach and keeps track of visited types to avoid infinite loops.
 *
 * The function takes two parameters: the type to start the traversal from, and
 * the location (file and line number) where this function was called from.
 *
 * @param type The type to start the cycle detection from. Must be non-NULL.
 * @param from The location (file and line number) where this function was called from.
 *
 * @return None. If a cycle is detected, an error message is printed and the program aborts.
 *
 * @warning This function uses assertions to check for invalid input and internal consistency.
 *          If these assertions fail, it may indicate a programming error or corrupted data.
 *
 * @pre The type hierarchy must be properly initialized before calling this function.
 *
 * @post If no cycle is detected, the function returns without any side effects. If a cycle
 *       is detected, an error message is printed and the program aborts.
 *
 * @note This function uses a recursive approach to traverse the type hierarchy. It may cause
 *       a stack overflow if the hierarchy is very deep or contains cycles.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgType* myType = ...; // initialize myType
 *           std::string from = "myFile.cpp:123";
 *           SageInterface::detectCycleInType(myType, from);
 *          @endcode
 */
/**
 * @fn SageInterface::checkForInitializers(SgNode* node)
 *
 * @brief Checks variable declarations for initializers in a given AST node.
 *
 * This function performs a preorder traversal of the abstract syntax tree (AST) rooted at the given SgNode, 
 * checking each variable declaration for an initializer. It reports on all variable declarations and their 
 * corresponding initializers, if any.
 *
 * @param node The root node of the AST to be traversed. Must not be nullptr.
 *
 * @return None
 *
 * @warning This function assumes that the input node is a valid SgNode in the ROSE AST framework.
 *           It does not perform any error checking on the input node.
 *
 * @pre The input node must not be nullptr.
 *      The ROSE AST framework must be properly initialized before calling this function.
 *
 * @post All variable declarations with initializers in the given AST will have been reported to stdout.
 *
 * @note This function is primarily used for debugging purposes, specifically to identify issues 
 *       with variable declarations and their initializers in the EDG 6.0 compiler frontend.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* node = ...; // obtain an AST node from the ROSE framework
 *           SageInterface::checkForInitializers(node);
 *          @endcode
 */
/**
 * @fn void SageInterface::clearSharedGlobalScopes(SgProject * project)
 *
 * @brief Clears shared global scopes in a SAGE project.
 *
 * This function resets the symbol tables for global variables, types, and function
 * types across files in a SAGE project. It is used to clear out any previously stored
 * information about these symbols.
 *
 * The function iterates over three different symbol tables: one for global variables,
 * one for global types, and one for global function types. For each table, it retrieves the
 * underlying hash multimap and clears its contents.
 *
 * @param project A pointer to an SgProject object representing the project whose shared
 *                 global scopes are to be cleared. Must not be nullptr.
 *
 * @return None
 *
 * @warning This function does not check if the input project is valid or if the symbol tables
 *          exist before attempting to clear them. It assumes that these preconditions have been
 *          met by the caller.
 *
 * @pre The input project must be a valid SgProject object, and its global scopes must have been
 *      initialized.
 *
 * @post The shared global scopes in the input project will be cleared, meaning their symbol tables
 *        will be empty.
 *
 * @note This function modifies the internal state of the input project. It does not modify any
 *       external data structures or objects.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject* project = new SgProject();
 *           // Initialize the project and its global scopes...
 *           SageInterface::clearSharedGlobalScopes(project);
 *          @endcode
 */
/**
 * @fn SageInterface::DeclarationSets* SageInterface::buildDeclarationSets(SgNode* n)
 *
 * @brief Builds a set of declaration statements from an AST subtree.
 *
 * This function constructs a collection of SgDeclarationStatement nodes by traversing
 * the abstract syntax tree (AST) rooted at the given node. It uses a preorder traversal
 * strategy to visit each node in the tree, and for each SgDeclarationStatement encountered,
 * it adds the statement to the declaration set.
 *
 * The function returns a pointer to the constructed DeclarationSets object, which contains
 * all the SgDeclarationStatement nodes found in the AST subtree. This allows clients to
 * iterate over the declarations and perform further analysis or processing as needed.
 *
 * @param n The root node of the AST subtree from which to build the declaration sets.
 *          Must be a valid non-null pointer to an SgNode object.
 *
 * @return A pointer to the constructed DeclarationSets object, containing all
 *         SgDeclarationStatement nodes found in the AST subtree. Returns nullptr if
 *         the input node is null or if no declarations are found in the tree.
 *
 * @warning The function does not perform any semantic analysis on the declarations;
 *          it simply collects them based on their syntactic structure. Clients must
 *          ensure that the resulting declaration sets are properly validated and processed.
 *
 * @pre The input node n must be a valid non-null pointer to an SgNode object.
 *      The AST subtree rooted at n must be properly constructed and well-formed.
 *
 * @post The returned DeclarationSets object contains all SgDeclarationStatement nodes
 *       found in the AST subtree. If no declarations are found, the function returns nullptr.
 *
 * @note This function uses a preorder traversal strategy to visit each node in the tree,
 *       which means that parent nodes are visited before their children. This allows clients
 *       to process declarations in the correct order and avoid potential issues with
 *       forward references or other dependencies between declarations.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create an AST subtree containing some declaration statements
 *           SgNode* astRoot = ...;
 *
 *           // Build the declaration sets from the AST subtree
 *           DeclarationSets* decls = SageInterface::buildDeclarationSets(astRoot);
 *
 *           // Iterate over the declarations and perform further analysis or processing
 *           for (auto& decl : *decls) {
 *             // Process the declaration as needed...
 *           }
 *          @endcode
 */
/**
 * @fn void SageInterface::addMessageStatement(SgStatement* stmt, string message)
 *
 * @brief Adds a message statement to the given SgStatement.
 *
 * This function adds a preprocessing information of type C_StyleComment
 * to the attached preprocessing info list of the given SgStatement. The 
 * comment contains the provided message and is marked as a transformation.
 *
 * @param stmt The SgStatement to which the message statement will be added.
 *
 * @param message The message that will be included in the comment.
 *
 * @return None
 *
 * @warning This function does not check if the provided SgStatement or message are valid.
 *          It is the responsibility of the caller to ensure their correctness.
 *
 * @pre stmt must be a non-null pointer to a valid SgStatement.
 *      message must be a valid string.
 *
 * @post A new PreprocessingInfo object will be created and added to the attached
 *       preprocessing info list of the given SgStatement. The comment will be marked as a transformation.
 *
 * @note This function is used to label dependent CPP directives in a separate file.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgStatement* stmt = ...; // obtain a valid SgStatement pointer
 *           string message = "This is a message";
 *           SageInterface::addMessageStatement(stmt, message);
 *          @endcode
 */

/**
 * @brief Empty function or ill-formed function detected.
 */


