/**
 * @fn template <typename NodeType> std::vector<NodeType*> querySubTree(SgNode* top, VariantT variant = (VariantT)NodeType::static_variant)
 *
 * @brief Queries the sub-tree rooted at a given node for nodes of a specific type.
 *
 * This function traverses the abstract syntax tree (AST) and collects all nodes
 * that match the specified type. The traversal is performed using a recursive
 * algorithm, starting from the topmost node in the sub-tree.
 *
 * @param top The root node of the sub-tree to be queried.
 *             Must not be NULL.
 * @param variant An optional parameter specifying the variant of the node type.
 *                 Defaults to NodeType::static_variant if not provided.
 *
 * @return A vector of pointers to nodes of type NodeType that are found in the sub-tree.
 *         The returned vector is empty if no matching nodes are found.
 *
 * @warning This function may throw an exception if the input parameters are invalid.
 *
 * @pre The input node 'top' must not be NULL, and the variant parameter must be valid for the specified NodeType.
 *
 * @post The returned vector contains all nodes of type NodeType that are present in the sub-tree rooted at 'top'.
 *
 * @note This function uses dynamic casting to convert SgNode pointers to NodeType pointers. This may incur a performance overhead if the number of nodes is large.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create an instance of the SageInterface class
 *           SageInterface sage;
 *           
 *           // Define a node type, e.g., SgFunctionDeclaration
 *           typedef SgFunctionDeclaration NodeType;
 *           
 *           // Get the root node of the AST
 *           SgNode* top = sage.getASTRoot();
 *           
 *           // Query the sub-tree for nodes of type NodeType
 *           std::vector<NodeType*> result = querySubTree<NodeType>(top);
 *           
 *           // Process the found nodes
 *           for (size_t i = 0; i < result.size(); ++i) {
 *               NodeType* node = result[i];
 *               // ...
 *           }
 *          @endcode
 */
/**
 * @fn std::vector<SgFile*> SageInterface::generateFileList()
 *
 * @brief Generates a list of SgFile nodes in the memory pool.
 *
 * This function traverses the memory pool to collect all SgFile nodes, which include both SgSourceFile and SgBinaryComposite IR nodes. 
 * It uses a custom ROSE_VisitTraversal class, FileTraversal, to visit each node in the memory pool and check if it is an SgFile node.
 *
 * @param None
 *
 * @return A vector of SgFile pointers representing the list of files found in the memory pool.
 *
 * @warning This function may return an empty vector if no SgFile nodes are found in the memory pool. 
 *          It does not guarantee that the returned vector will be non-empty.
 *
 * @pre The SageInterface object must have been properly initialized before calling this function.
 *
 * @post The returned vector of SgFile pointers is valid and can be used to access the corresponding IR nodes.
 *
 * @note This function uses a custom traversal class, FileTraversal, which visits each node in the memory pool and checks if it is an SgFile node.
 *       The function also traverses both SgSourceFile and SgBinaryComposite IR nodes using their respective traverseMemoryPoolNodes() methods.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SageInterface sage;
 *           std::vector<SgFile*> fileList = sage.generateFileList();
 *           for (std::vector<SgFile*>::iterator it = fileList.begin(); it != fileList.end(); ++it) {
 *             SgFile* file = *it;
