 *
 * @warning The input scope must not be NULL, otherwise a ROSE_ASSERT will trigger. Also,
 *          if the input vector of new statements is empty, this function has no effect.
 *
 * @pre  The input scope and all its contained statements must have been properly initialized
 *       before calling this function.
 *
 * @post If a non-declaration statement was found in the scope, the new statements will be inserted
 *        immediately before it. Otherwise, they will be appended at the end of the scope.
 *
 * @note This function modifies the input scope's statement list by inserting or appending new
 *       statements.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgScopeStatement* myScope = ...; // initialize a scope statement
 *           std::vector<SgStatement*> newStmts; // create an empty vector of statements
 *           // populate the vector with some new statements...
 *           SageInterface::insertStatementListBeforeFirstNonDeclaration(newStmts, myScope);
 *          @endcode
 */
/**
 * @fn SgStatement* SageInterface::lastFrontEndSpecificStatement(SgGlobal* globalScope)
 *
 * @brief Retrieves the last frontend-specific statement in a global scope.
 *
 * This function iterates over the declarations in a given global scope and returns
 * the last statement that is frontend-specific. A frontend-specific statement is one
 * whose file information indicates that it was generated by the frontend.
 *
 * The purpose of this function is to provide a way for clients to determine where to insert
 * new statements into a global scope, particularly when inserting at the top of the scope.
 *
 * @param globalScope The global scope in which to find the last frontend-specific statement.
 *                     Must not be NULL.
 *
 * @return A pointer to the last frontend-specific statement in the given global scope,
 *          or NULL if no such statement exists. If an error occurs, a fatal assertion
 *          will be triggered.
 *
 * @warning The function assumes that the input global scope is valid and has at least one declaration.
 *
 * @pre The globalScope parameter must not be NULL.
 *
 * @post The returned pointer will either point to a frontend-specific statement or be NULL.
 *
 * @note This function uses an iterator to traverse the declarations in the global scope,
 *       which may involve iterating over a large number of statements. Clients should
 *       use this function judiciously and only when necessary.
 *
 * @example The following example demonstrates how to use this function:
 *          @code
 *           SgGlobal* globalScope = ...; // obtain a pointer to the global scope
 *           SgStatement* lastStatement = SageInterface::lastFrontEndSpecificStatement(globalScope);
 *           if (lastStatement != NULL) {
 *               printf("Last frontend-specific statement: %s\n", lastStatement->class_name().c_str());
 *           } else {
 *               printf("No frontend-specific statements found.\n");
 *           }
 *          @endcode
 */
/**
 * @fn void SageInterface::removeStatement(SgStatement* targetStmt, bool autoRelocatePreprocessingInfo)
 *
 * @brief Removes the input statement from its parent statement or SgGlobal.
 *
 * This function removes the input statement and optionally relocates any attached comments and/or CPP directives.
 * The relocation is done by finding a surrounding statement in the same file (looking up then down in the sequence of statements in this block) and moving the comments/CPP directives to that statement. If no suitable statement is found, SgGlobal may be returned.
 *
 * @param targetStmt The statement to remove.
 * @param autoRelocatePreprocessingInfo Flag indicating whether attached comments and/or CPP directives should be relocated.
 */

/**
 * @details
 * This function performs the following steps:
 * 1. Checks if the input statement is a SgBasicBlock, in which case no relocation of preprocessing information is done.
 * 2. Finds any attached comments and/or CPP directives to the target statement.
 * 3. If such comments/CPP directives exist and autoRelocatePreprocessingInfo is true, relocates them by finding a surrounding statement in the same file (looking up then down in the sequence of statements in this block) and moving the comments/CPP directives to that statement.
 * 4. Resets internal data structures that have references to the target statement (e.g., macro expansions).
 * 5. Removes the target statement from its parent statement or SgGlobal.
 *
 * @note This function is not supported within Microsoft Windows due to unknown reasons.
 */
/**
 * @fn void SageInterface::deepDelete(SgNode* root)
 *
 * @brief Recursively deletes an abstract syntax tree (AST) rooted at the given node.
 *
 * This function traverses the AST in post-order and deletes each node, ensuring that
 * all child nodes are deleted before their parents to prevent memory leaks.
 *
 * The actual deletion is performed by either a Visitor class or the deleteAST function,
 * depending on the compilation configuration.
 *
 * @param root The root node of the AST to be deleted. Must not be NULL.
 *
 * @return None
 *
 * @warning Deleting an AST can lead to undefined behavior if any pointers to nodes within
 *          the tree are still being used after deletion.
 *
 * @pre The input parameter 'root' must point to a valid SgNode object that is part of an AST.
 *
 * @post The entire AST rooted at 'root' has been deleted, and all memory allocated for its nodes has been freed.
 *
 * @note This function does not perform any error checking on the input parameter. It assumes
 *       that the caller has ensured the validity and correctness of the input data.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* astRoot = ...; // Assume 'astRoot' points to a valid AST root node
 *           SageInterface sage;
 *           sage.deepDelete(astRoot);
 *          @endcode
 */
/**
 * @fn void SageInterface::replaceStatement(SgStatement* oldStmt, SgStatement* newStmt, bool movePreprocessingInfoValue/* = false*/)
 *
 * @brief Replaces an existing statement with a new one in the AST.
 *
 * This function replaces an existing statement (oldStmt) with a new one (newStmt)
 * within the Abstract Syntax Tree (AST). It ensures that the replacement is
 * performed correctly by handling various cases, including replacing the body of
 * a Fortran DO loop and updating preprocessing information.
 *
 * @param oldStmt The existing statement to be replaced. Must not be null.
 * @param newStmt The new statement to replace the existing one. Must not be null.
 * @param movePreprocessingInfoValue Optional flag indicating whether to move
 *          preprocessing information from the old statement to the new one.
 *          Defaults to false if not provided.
 *
 * @return None
 *
 * @warning This function modifies the AST and may have unintended consequences
 *          if not used carefully. Ensure that the replacement is valid and does
 *          not violate any AST consistency rules.
 *
 * @pre The old statement (oldStmt) must exist in the AST and be a child of some
 *      parent node. The new statement (newStmt) must also be a valid statement.
 * @post The old statement (oldStmt) is replaced by the new statement (newStmt)
 *       in the AST, and preprocessing information is updated if requested.
 *
 * @note This function may need to handle special cases, such as replacing the
 *       body of a Fortran DO loop or updating physical file IDs.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgStatement* oldStmt = ...; // existing statement to replace
 *           SgStatement* newStmt = ...; // new statement to replace with
 *           SageInterface::replaceStatement(oldStmt, newStmt);
 *          @endcode
 */
/**
 * @fn SgNode* SageInterface::replaceWithPattern (SgNode * anchor, SgNode* new_pattern)
 *
 * @brief Replaces a given anchor expression with a new pattern by replacing all occurrences of opaque expressions in the pattern with copies of the anchor.
 *
 * This function takes an anchor node and a new pattern node as input. It first checks if both nodes are valid SgExpression instances, then replaces all SgExpression within the pattern with copies of the anchor. Finally, it replaces the original anchor expression with the modified pattern expression.
 *
 * @param anchor The anchor node to be replaced. Must be a valid SgExpression instance.
 * @param new_pattern The new pattern node that will replace the anchor. Must be a valid SgExpression instance.
 *
 * @return The new pattern node after replacement.
 *
 * @warning This function assumes that the input nodes are valid and does not perform extensive error checking. It also assumes that the replacement operation is valid in the context of the abstract syntax tree.
 *
 * @pre The anchor and new_pattern nodes must be valid SgExpression instances.
 * @post The original anchor expression will be replaced with the modified pattern expression.
 *
 * @note This function uses a recursive approach to replace all occurrences of opaque expressions in the pattern. It also performs deep copying of the anchor expression to ensure that the replacement is done correctly.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* anchor = ...; // some valid SgExpression instance
 *           SgNode* new_pattern = ...; // some valid SgExpression instance
 *           SgNode* result = SageInterface::replaceWithPattern(anchor, new_pattern);
 *          @endcode
 */
/**
 * @fn void SageInterface::replaceVariableReferences(SgVariableSymbol* old_sym, SgVariableSymbol* new_sym, SgScopeStatement * scope)
 *
 * @brief Replaces variable references in a given scope.
 *
 * This function replaces all occurrences of the old variable symbol with the new variable symbol
 * within the specified scope. It traverses the abstract syntax tree (AST) rooted at the given scope,
 * identifies variable reference expressions that refer to the old symbol, and updates them to refer to the new symbol.
 *
 * @param old_sym The variable symbol to be replaced. Must not be NULL.
 * @param new_sym The new variable symbol to replace with. Must not be NULL and must not be the same as old_sym.
 * @param scope The scope within which the replacement should occur. Must not be NULL.
 *
 * @return None
 *
 * @warning This function modifies the AST by updating variable reference expressions.
 *
 * @pre The input parameters old_sym, new_sym, and scope must satisfy the assertions at the beginning of this function.
 *
 * @post All variable references to old_sym within the given scope have been replaced with references to new_sym.
 *
 * @note This function uses the NodeQuery class to traverse the AST and identify variable reference expressions.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgVariableSymbol* old_var = ...; // assume some initialization
 *           SgVariableSymbol* new_var = ...; // assume some initialization
 *           SgScopeStatement* scope_stmt = ...; // assume some initialization
 *           SageInterface::replaceVariableReferences(old_var, new_var, scope_stmt);
 *          @endcode
 */
/**
 * @fn bool SageInterface::statementCanBeTransformed(SgStatement* stmt)
 *
 * @brief Determines if a given statement can be transformed using token-based unparsing.
 *
 * This function checks if the source file associated with the input statement
 * can be supported using token-based unparsing. It returns true if the statement
 * can be transformed, and false otherwise.
 *
 * The function uses the EDG/ROSE translation's include file map to look up the
 * source file name and determine if statements from this file can be transformed.
 *
 * @param stmt The input statement for which the transformation capability is to be checked.
 *
 * @return True if the statement can be transformed, false otherwise.
 *
 * @warning If the source file associated with the input statement is not found,
 *          an error message is printed and the function returns true by default.
 *
 * @pre The input statement must be non-null.
 *
 * @post The function returns a boolean value indicating whether the statement can be transformed.
 *
 * @note This function uses the EDG/ROSE translation's include file map to look up the source file name.
 *       If the source file is not found in the map, the function returns true by default.
 *
 * @example
 *          @code
 *           SgStatement* stmt = ...; // obtain a statement object
 *           bool canBeTransformed = SageInterface::statementCanBeTransformed(stmt);
 *           if (canBeTransformed) {
 *               printf("The statement can be transformed.\n");
 *           } else {
 *               printf("The statement cannot be transformed.\n");
 *           }
 *          @endcode
 */
/**
 * @fn std::pair<SgVariableDeclaration*, SgExpression*> rose::createTemporaryVariableForRValue(SgExpression* expression, SgScopeStatement* scope, bool initializeInDeclaration, SgAssignOp** reEvaluate)
 *
 * @brief Creates a temporary variable to hold the value of an r-value expression.
 *
 * This function generates a unique temporary variable declaration and assigns
 * it the value of the given r-value expression. The variable is declared in the
 * specified scope. Optionally, the variable can be initialized with the value
 * of the expression at its point of declaration.
 *
 * @param expression The r-value expression for which a temporary variable is to be created.
 *
 * @param scope The scope in which the temporary variable will be declared.
 *
 * @param initializeInDeclaration If true, the temporary variable will be initialized with the value
 *          of the expression at its point of declaration. Otherwise, it will not be initialized until later.
 *
 * @param reEvaluate A pointer to a location where an assignment operator can be stored that re-evaluates
 *          the original expression and assigns its result back to the temporary variable.
 *
 * @return A pair containing the declaration for the temporary variable and an expression referencing the variable.
 * 
 * @warning If the input expression is of reference type, the generated temporary variable will have a pointer type,
 *          and re-assigning the value of the variable may not be possible. Also, if the expression has array type,
 *          the generated temporary variable will have a pointer type referring to the base type.
 *
 * @pre The input expression must be non-null and of r-value type.
 * 
 * @post A unique temporary variable declaration is created in the specified scope, and an expression referencing
 *       the variable is returned. If initializeInDeclaration is true, the variable is initialized with the value of
 *       the expression at its point of declaration.
 *
 * 
 * @note This function modifies the input AST by adding a new variable declaration to it.
 *
 * 
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgExpression* expr = ...; // some r-value expression
 *           SgScopeStatement* scope = ...; // some scope
 *           bool initializeInDeclaration = true;
 *           SgAssignOp** reEvaluate = NULL;
 * 
 *           std::pair<SgVariableDeclaration*, SgExpression*> result =
 *               rose::createTemporaryVariableForRValue(expr, scope, initializeInDeclaration, reEvaluate);
 * 
 *           SgVariableDeclaration* tempVarDecl = result.first;
 *           SgExpression* varRefExpr = result.second;
 *          @endcode
 */
/**
 * @fn std::pair<SgVariableDeclaration*, SgExpression*> createTemporaryVariable(SgExpression* expression, SgScopeStatement* scope)
 *
 * @brief Creates a temporary variable declaration for the given expression and returns the declaration along with an expression referencing the new variable.
 *
 * This function generates a unique name for the temporary variable, determines its type based on the input expression (considering array types), 
 * and initializes the variable using an assignment initializer. It then constructs a variable reference expression to be used in place of the original expression.
 *
 * @param expression The SgExpression object representing the expression for which a temporary variable is to be created.
 * @param scope The SgScopeStatement object specifying the scope in which the temporary variable declaration will be inserted.
 *
 * @return A pair containing the SgVariableDeclaration* for the newly created temporary variable and an SgExpression* referencing this new variable.
 *
 * @warning If the input expression has an array type, the function may modify it to use a pointer type for the temporary variable.
 *
 * @pre The input expression must have a valid type. The scope object must be non-null and represent a valid statement scope.
 *
 * @post A new SgVariableDeclaration is created and inserted into the given scope, along with an assignment initializer using a copy of the original expression.
 *
 * @note This function assumes that the input expression does not already have side effects or dependencies on other variables in the same scope.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create a temporary variable for an expression
 *           SgExpression* expr = SageBuilder::buildIntVal(10);
 *           SgScopeStatement* scopeStmt = ...; // Obtain or create the relevant scope statement
 *           std::pair<SgVariableDeclaration*, SgExpression*> result = createTemporaryVariable(expr, scopeStmt);
 *           SgVariableDeclaration* tempVarDecl = result.first;
 *           SgExpression* varRefExpr = result.second;
 *
 *           // Use the new variable reference expression in your code
 *          @endcode
 */
/**
 * @fn SgVariableSymbol* SageInterface::appendArg(SgFunctionParameterList *paraList, SgInitializedName* initName)
 *
 * @brief Appends an argument to a function parameter list.
 *
 * This function adds an argument to the end of a given function parameter list. 
 * It is used to dynamically construct or modify function calls in the AST.
 *
 * @param paraList The function parameter list to which the argument will be appended.
 *                  Must not be NULL.
 * @param initName The initial name of the variable symbol representing the argument.
 *                  Must not be NULL.
 *
 * @return A pointer to the newly added variable symbol, or NULL if an error occurs.
 *
 * @warning If the input parameter list is NULL or the initial name is NULL,
 *          this function will return NULL without modifying the AST.
 *
 * @pre The input parameter list and initial name must be valid and non-NULL.
 *
 * @post The argument has been appended to the end of the parameter list if no errors occurred.
 *
 * @note This function does not perform any semantic checks on the added argument.
 *       It is the caller's responsibility to ensure that the argument is semantically correct.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgFunctionParameterList* paraList = ...; // assume a valid parameter list
 *           SgInitializedName* initName = ...; // assume a valid initial name
 *           SgVariableSymbol* arg = appendArg(paraList, initName);
 *           if (arg != NULL) {
 *             // the argument was successfully appended
 *           } else {
 *             // an error occurred during appending
 *           }
 *          @endcode
 */
/**
 * @fn SgVariableSymbol* SageInterface::prependArg(SgFunctionParameterList *paraList, SgInitializedName* initName)
 *
 * @brief Prepends an argument to a function parameter list.
 *
 * This function inserts a new argument at the beginning of a given function
 * parameter list. It is used to modify the parameters of a function symbol in
 * the Sage III abstract syntax tree.
 *
 * The insertion is performed by creating a new SgVariableSymbol and adding it
 * to the front of the parameter list. If the operation is successful, a pointer
 * to the newly created SgVariableSymbol is returned; otherwise, NULL is returned.
 *
 * @param paraList A pointer to an SgFunctionParameterList representing the list
 *                 of parameters for which an argument will be prepended.
 *
 * @param initName An SgInitializedName representing the name and initial value
 *                 of the new parameter that will be inserted at the beginning
 *                 of the function parameter list. Must not be NULL.
 *
 * @return A pointer to the newly created SgVariableSymbol if successful; otherwise, NULL.
 *
 * @warning The caller is responsible for ensuring that the input parameters are valid and consistent.
 *          Failure to do so may result in undefined behavior or errors during later processing of the AST.
 *
 * @pre The parameter list must not be empty, and the initName argument must not be NULL.
 *
 * @post If successful, a new SgVariableSymbol will have been created and prepended to the function parameter list.
 *
 * @note This function modifies the original AST by inserting a new symbol; it does not create a copy of the original AST.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create an SgFunctionParameterList with an existing parameter
 *           SgFunctionParameterList* paraList = ...;
 *           
 *           // Create an SgInitializedName for the new parameter
 *           SgInitializedName* initName = ...;
 *           
 *           // Prepend the new argument to the function parameter list
 *           SgVariableSymbol* newParam = SageInterface::prependArg(paraList, initName);
 *
 *           // Use the newly created symbol as needed...
 *          @endcode
 */
/**
 * @fn void SageInterface::appendExpression(SgExprListExp *expList, SgExpression* exp)
 *
 * @brief Appends an expression to a list of expressions and sets the parent-child relationship.
 *
 * This function takes a list of expressions (SgExprListExp) and an individual expression (SgExpression),
 * appends the latter to the former, and establishes the parent-child relationship between them.
 * The function relies on the ROSE library's assertion mechanism to ensure that both input arguments are valid.
 *
 * @param expList A pointer to a list of expressions. Must not be NULL.
 * @param exp     A pointer to an individual expression. Must not be NULL.
 *
 * @return None (void)
 *
 * @warning This function does not perform any error handling beyond the assertions provided by ROSE_ASSERT.
 *          If either input argument is invalid, the program will terminate with an assertion failure.
 *
 * @pre Both expList and exp must be non-NULL pointers to valid objects of their respective types.
 *
 * @post The expression list (expList) has been modified to include the new expression (exp), and the parent-child relationship
 *       between them has been established. Specifically, expList is now a parent of exp in the abstract syntax tree (AST).
 *
 * @note This function does not create copies of either the input list or expression; it modifies the original objects.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgExprListExp* myList = new SgExprListExp();
 *           SgExpression* myExpression = new SgExpression(); // assume some initialization of myExpression here
 *           SageInterface::appendExpression(myList, myExpression);
 *          @endcode
 */
/**
 * @fn void SageInterface::appendExpressionList(SgExprListExp* expList, const std::vector<SgExpression*>& exp)
 *
 * @brief Appends a list of expressions to an expression list.
 *
 * This function iterates over a vector of SgExpression pointers and appends each
 * expression to the provided SgExprListExp using the appendExpression function.
 *
 * @param expList The SgExprListExp to which the expressions will be appended.
 *                Must not be NULL.
 *
 * @param exp     A vector of SgExpression pointers to be appended to the expression list.
 *               Must not contain any NULL elements.
 *
 * @return None
 *
 * @warning This function does not perform any error checking on the input parameters.
 *          It is the caller's responsibility to ensure that the inputs are valid.
 *
 * @pre The expList parameter must not be NULL, and the exp vector must not contain any NULL elements.
 *
 * @post The expressions in the exp vector will have been appended to the expList.
 *
 * @note This function uses a simple iterative approach to append the expressions to the list.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *            SgExprListExp* myList = ...; // Initialize myList
 *            std::vector<SgExpression*> myExpressions;
 *            myExpressions.push_back(new SgIntVal(1));
 *            myExpressions.push_back(new SgIntVal(2));
 *            SageInterface::appendExpressionList(myList, myExpressions);
 *          @endcode
 */
/**
 * @fn template <class actualFunction> void setParameterList(actualFunction *func,SgFunctionParameterList *paralist)
 *
 * @brief Sets a new parameter list for the given function.
 *
 * This function sets a new parameter list for the given function. It first checks if
 * the provided function and parameter list are not NULL, then it updates the function's
 * parameter list with the new one, taking care of any existing parameter lists that may be
 * in use. Additionally, it handles language-specific requirements such as setting the declptr
 * for each SgInitializedName IR node in the parameter list.
 *
 * @param func The function to which a new parameter list is to be set.
 *             Must not be NULL.
 *
 * @param paralist The new parameter list to be set for the given function.
 *                 Must not be NULL.
 *
 * @return None
 *
 * @warning Sharing parameter lists can corrupt symbol tables. If a shared parameter list
 *          is detected, a warning message will be displayed and the program may terminate.
 *
 * @pre The provided function and parameter list must not be NULL.
 *
 * @post The function's parameter list has been updated with the new one.
 *
 * @note This function handles language-specific requirements such as setting the declptr
 *       for each SgInitializedName IR node in the parameter list.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create a sample function and parameter list
 *           SgFunctionDeclaration* func = new SgFunctionDeclaration();
 *           SgFunctionParameterList* paralist = new SgFunctionParameterList();
 *
 *           // Set the new parameter list for the given function
 *           setParameterList(func, paralist);
 *          @endcode
 */
/**
 * @fn void SageInterface::setPragma(SgPragmaDeclaration* decl, SgPragma *pragma)
 *
 * @brief Sets the pragma declaration for a given SgPragma object.
 *
 * This function associates an SgPragma object with its corresponding SgPragmaDeclaration object.
 * It also sets the parent of the SgPragma object to the SgPragmaDeclaration object.
 *
 * @param decl A pointer to the SgPragmaDeclaration object. Must not be NULL.
 * @param pragma A pointer to the SgPragma object. Must not be NULL.
 *
 * @return None
 *
 * @warning If the SgPragmaDeclaration object already has an associated SgPragma object, it will be deleted before setting the new one.
 *
 * @pre The input pointers decl and pragma must not be NULL.
 *
 * @post The SgPragmaDeclaration object's pragma is set to the given SgPragma object, and the SgPragma object's parent is set to the SgPragmaDeclaration object.
 *
 * @note This function does not perform any checks on the validity of the input objects beyond the preconditions.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgPragmaDeclaration* decl = new SgPragmaDeclaration();
 *           SgPragma* pragma = new SgPragma();
 *           SageInterface::setPragma(decl, pragma);
 *          @endcode
 */
/**
 * @fn void replaceExpression(SgExpression* oldExp, SgExpression* newExp, SgNode* parent)
 * @brief Replaces an old expression with a new one in a given parent node.
 *
 * This function takes three parameters: the old expression to be replaced,
 * the new expression to replace it with, and the parent node where the replacement
 * should occur. It traverses the AST of the parent node to find all occurrences
 * of the old expression and replaces them with the new one.
 *
 * @param oldExp The old expression to be replaced.
 * @param newExp The new expression to replace it with.
 * @param parent The parent node where the replacement should occur.
 */

/**
 * @fn void SageInterface::replaceSubexpressionWithStatement(SgExpression* from, StatementGenerator* to)
 *
 * @brief Replaces a subexpression with a statement in the AST.
 *
 * This function replaces a given SgExpression node (from) with a statement generated by
 * the provided StatementGenerator object (to). It first tries to replace the expression
 * directly if it is an assignment or has no parent. If not, it splits the expression into
 * an initializer and converts it into an assignment, then replaces the resulting statement.
 *
 * @param from The SgExpression node to be replaced.
 * @param to The StatementGenerator object that generates the replacement statement.
 *
 * @return None
 *
 * @warning This function modifies the AST by replacing nodes. Use with caution.
 *
 * @pre The input expression (from) must not be NULL and must have a valid parent in the AST.
 *
 * @post The original SgExpression node is replaced with a new statement generated by the StatementGenerator object.
 *
 * @note This function assumes that the input expression can be safely replaced without affecting
 *       the correctness of the program. It does not perform any semantic checks on the replacement.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgExpression* expr = ...; // some expression node in the AST
 *           StatementGenerator* stmtGen = new MyStatementGenerator(); // a custom statement generator
 *           SageInterface::replaceSubexpressionWithStatement(expr, stmtGen);
 *          @endcode
 */
/**
 * @fn void SageInterface::setOperand(SgExpression* target, SgExpression* operand)
 *
 * @brief Sets the operand of a given expression.
 *
 * This function sets the operand of a given expression to a new value. It handles
 * different types of expressions and updates their operands accordingly.
 *
 * The function takes two parameters: the target expression whose operand is to be set,
 * and the new operand expression. It first checks if both parameters are valid, then
 * uses a switch statement to handle different types of expressions.
 *
 * For each type of expression, it calls the corresponding setter method to update the
 * operand. If the expression type is not handled by the switch statement, it checks if
 * the expression is a unary operation and updates its operand accordingly. If none of
 * these cases match, it prints an error message and aborts.
 *
 * Finally, the function sets the parent of the new operand to the target expression
 * and marks the left-hand side values of the target expression.
 *
 * @param target The target expression whose operand is to be set. Must not be NULL.
 * @param operand The new operand expression. Must not be NULL and must not be the same as the target expression.
 *
 * @return None
 *
 * @warning If the target expression is not one of the handled types, an error message will be printed and the program will abort.
 *
 * @pre The target expression and the operand expression must not be NULL. The target expression and the operand expression must not be the same.
 *
 * @post The operand of the target expression will be updated to the new value.
 *
 * @note This function assumes that the target expression and the operand expression are valid and have been properly initialized.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *            SgExpression* target = ...; // some expression
 *            SgExpression* operand = ...; // some other expression
 *            SageInterface::setOperand(target, operand);
 *          @endcode
 */
/**
 * @fn void SageInterface::setLhsOperand(SgExpression* target, SgExpression* lhs)
 *
 * @brief Sets the left-hand side operand of a binary expression.
 *
 * This function updates the left-hand side operand of a given binary expression
 * with a new expression. It supports various types of binary expressions,
 * including variable argument copy operations and binary operations.
 *
 * The function first checks if the target expression is valid and then attempts
 * to set its left-hand side operand based on its type. If the target expression is a
 * variable argument copy operation, it sets the left-hand side operand directly.
 * For binary operations, it also checks if the right-hand side operand is available
 * before setting the left-hand side operand.
 *
 * @param target The binary expression whose left-hand side operand needs to be set.
 *                Must not be NULL and must be a valid SgExpression object.
 *
 * @param lhs    The new left-hand side operand for the target expression.
 *               Must not be NULL and must be a valid SgExpression object.
 *               Must not be the same as the target expression.
 *
 * @return None
 *
 * @warning If the target expression is not a supported type, an error message will be printed to the console and the program will abort.
 *
 * @pre The target expression and the new left-hand side operand must not be NULL.
 *      The target expression and the new left-hand side operand must not be the same object.
 *
 * @post The left-hand side operand of the target expression will be updated with the new expression.
 *       If both the left-hand side and right-hand side operands are available, the function markLhsValues() will be called to set the lvalue for the expression.
 *
 * @note This function assumes that the input expressions are valid and well-formed. It does not perform any additional validation or error checking beyond the initial assertions.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgExpression* target = ...; // some binary expression
 *           SgExpression* lhs = ...;    // some new left-hand side operand
 *           SageInterface::setLhsOperand(target, lhs);
 *          @endcode
 */
/**
 * @fn void SageInterface::setRhsOperand(SgExpression* target, SgExpression* rhs)
 *
 * @brief Sets the right-hand side operand of a binary expression.
 *
 * This function sets the right-hand side operand of a given binary expression
 * and updates the parent-child relationship between the operands. It also checks
 * if both left-hand side and right-hand side operands are available to set the 
 * lvalue property of the expression.
 *
 * @param target The binary expression whose right-hand side operand is to be set.
 *                Must not be NULL.
 * @param rhs    The new right-hand side operand. Must not be NULL and must not be
 *               the same as the target expression.
 *
 * @return None
 *
 * @warning If the target expression is not a binary expression (e.g., SgVarArgCopyOp,
 *          SgVarArgStartOp, or SgBinaryOp), an error message will be printed and the 
 *          program will abort.
 *
 * @pre The target expression must not be NULL, and the right-hand side operand must
 *      not be NULL. The target expression must not be the same as the right-hand side
 *      operand.
 *
 * @post The right-hand side operand of the target expression is set to the new value,
 *       and the parent-child relationship between the operands is updated. If both 
 *       left-hand side and right-hand side operands are available, the lvalue property
 *       of the expression is also set.
 *
 * @note This function assumes that the input expressions are valid and correctly 
 *       formed. It does not perform any additional checks or validation on the inputs.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgExpression* target = ...; // some binary expression
 *           SgExpression* rhs = ...;    // new right-hand side operand
 *           SageInterface::setRhsOperand(target, rhs);
 *          @endcode
 */
/**
 * @fn void SageInterface::removeAllOriginalExpressionTrees(SgNode* top)
 *
 * @brief Removes all original expression trees from the given SgNode.
 *
 * This function traverses the abstract syntax tree (AST) rooted at the given
 * SgNode and removes any original expression trees associated with SgValueExp
 * or SgCastExp nodes. The removal is done by setting the originalExpressionTree
 * attribute of these nodes to NULL.
 *
 * @param top The root node of the AST from which to remove original expression trees.
 *
 * @return None
 *
 * @warning This function modifies the input AST in-place and does not perform any checks for
 *          null or invalid input. It is the caller's responsibility to ensure that the input
 *          SgNode is valid and can be safely traversed.
 *
 * @pre The input SgNode must be a valid node in an abstract syntax tree.
 *
 * @post All original expression trees associated with SgValueExp and SgCastExp nodes
 *       in the AST rooted at the input SgNode have been removed.
 *
 * @note This function uses a recursive traversal of the AST to find and remove
 *       original expression trees. It does not perform any optimizations or caching.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SageInterface sage;
 *           SgNode* astRoot = ...; // obtain the root node of an abstract syntax tree
 *           sage.removeAllOriginalExpressionTrees(astRoot);
 *          @endcode
 */
/**
 * @fn void SageInterface::moveToSubdirectory(std::string directoryName, SgFile* file)
 *
 * @brief Moves a file to a subdirectory in the project.
 *
 * This function transforms the abstract syntax tree (AST) by inserting a new SgDirectory node
 * between the given SgFile and its parent. It updates the parents and file lists accordingly,
 * effectively moving the file to the specified subdirectory when unparsed.
 *
 * The transformation is done in three steps:
 * 1. A new SgDirectory node is created with the given directory name.
 * 2. The SgDirectory node is inserted between the SgFile and its parent (either an SgProject or another SgDirectory).
 * 3. The file is moved to the new subdirectory by updating the parents and file lists.
 *
 * @param directoryName The name of the subdirectory where the file will be moved.
 * @param file The SgFile node representing the file to be moved.
 *
 * @return None
 *
 * @warning This function modifies the AST, which may affect the behavior of other functions that operate on the same AST.
 *
 * @pre The given SgFile node must exist in the project and have a valid parent (either an SgProject or another SgDirectory).
 * @post The file is moved to the specified subdirectory, and the parents and file lists are updated accordingly.
 *
 * @note This function uses the ROSE_ASSERT macro to ensure that the preconditions are met. If the assertions fail, it indicates a programming error.
 *
 * @example
 * @code
 *   SageInterface sage;
 *   SgFile* file = ...; // assume a valid SgFile node
 *   std::string directoryName = "new_subdirectory";
 *   sage.moveToSubdirectory(directoryName, file);
 * @endcode
 */
/**
 * @fn SgStatement* findSurroundingStatementFromSameFile(SgStatement* targetStmt) 
 * @brief Finds a surrounding statement from the same file as the target statement.
 *
 * This function traverses the source sequence to find a statement in the same file
 * that can be used to attach comments or CPP directives. It first tries to find a 
 * preceding statement, and if none is found, it looks for a following statement.
 *
 * @param targetStmt The statement from which to start searching for a surrounding statement.
 * @return A pointer to the surrounding statement, or NULL if no such statement exists.
 */

/**
 * @fn void remove_and_reattach_comments(SgNode* sourceStatement, SgNode* destinationStatement)
 * @brief Removes the attached preprocessing info from a source statement and reattaches it to a destination statement.
 *
 * This function takes into account the relative position of the comments with respect to the statements.
 * It handles different scenarios, such as when the destination statement is an ancestor of the source statement,
 * or when the target statement is after the source statement. In this case, it adjusts the relative position
 * of the comments and prepends them to the first comment of the destination statement.
 *
 * @param sourceStatement The statement from which the preprocessing info will be removed.
 * @param destinationStatement The statement to which the preprocessing info will be reattached.
 */

/**
 * @fn void SageInterface::moveTemplateInstantiationToValidNamespace(SgNode* node)
 * @brief Moves a template instantiation to a valid namespace if it is not already in one.
 *
 * This function checks if the given SgNode (which should be a template instantiation) is inside a valid namespace. 
 * If it's not, then it tries to move it into the correct namespace by wrapping it with the necessary directives.
 *
 * @param node The SgNode that represents the template instantiation to be moved.
 */

/**
 * @fn bool SageInterface::isTemplateInstantiationNode(SgNode* node)
 *
 * @brief Checks if a given SgNode represents a template instantiation.
 *
 * This function determines whether the provided node corresponds to a template
 * instantiation in the source code. It checks for various types of nodes that can
 * represent template instantiations, including declarations and definitions.
 *
 * @param node The SgNode to be checked for template instantiation.
 *
 * @return True if the node represents a template instantiation; false otherwise.
 *
 * @warning This function may return incorrect results if the input node is not
 * properly initialized or if it does not correspond to a valid template
 * instantiation in the source code.
 *
 * @pre The input node must be non-null and represent a valid SgNode in the ROSE AST.
 *
 * @post The function will return true if the node represents a template instantiation;
 * false otherwise. No side effects are guaranteed.
 *
 * @note This function uses a combination of checks to determine whether the node
 * represents a template instantiation, including checking for specific types of
 * declarations and definitions.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* node = ...; // Initialize node with some value
 *           bool isTemplateInstantiation = SageInterface::isTemplateInstantiationNode(node);
 *           if (isTemplateInstantiation) {
 *               printf("Node represents a template instantiation\n");
 *           } else {
 *               printf("Node does not represent a template instantiation\n");
 *           }
 *          @endcode
 */
/**
 * @fn void SageInterface::wrapAllTemplateInstantiationsInAssociatedNamespaces(SgProject* root)
 *
 * @brief Wraps all template instantiations in their associated namespaces.
 *
 * This function traverses the Abstract Syntax Tree (AST) of a given SgProject and 
 * identifies all template instantiations. It then moves each instantiation into its 
 * associated namespace, effectively wrapping it.
 *
 * The function uses a recursive approach to traverse the AST, checking each node for 
 * template instantiations. If an instantiation is found, it is added to a vector of 
 * SgDeclarationStatement pointers. After traversing the entire AST, the function then 
 * iterates over this vector and moves each declaration into its associated namespace.
 *
 * @param root The root node of the SgProject's Abstract Syntax Tree (AST).
 *
 * @return None
 *
 * @warning This function modifies the input AST by moving template instantiations 
 *          into their associated namespaces. Use with caution.
 *
 * @pre The input SgProject must be valid and have a properly constructed AST.
 *
 * @post All template instantiations in the input SgProject's AST will be wrapped in 
 *       their associated namespaces.
 *
 * @note This function is not available when using CMake due to limitations in the 
 *       current implementation. It is only available when using autotools.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject* project = ...; // Initialize a valid SgProject instance
 *           SageInterface::wrapAllTemplateInstantiationsInAssociatedNamespaces(project);
 *          @endcode
 */
/**
 * @fn SageInterface::resetInternalMapsForTargetStatement(SgStatement* sourceStatement)
 *
 * @brief Resets internal maps for a target statement by updating data structures that hold references to the statement.
 *
 * This function allows the modification of the input statement to trigger operations on internal
 * data structures that hold references to such statements. An example is the macro expansion
 * data structures that have a reference to the statements that are associated with and macro expansion.
 * If a statement associated with a macro expansion is removed, then the macro expansion needs to be
 * updated to force all of the statements to be marked as transformed (so that the AST will be unparsed
 * instead of the tokens representing the macro or some partial representation of the transformed
 * statements and the macro call).
 *
 * @param sourceStatement The statement for which internal maps need to be reset.
 *                        Must not be NULL. If the statement has not yet been added to the AST, it will not return a valid pointer.
 *
 * @return None
 *
 * @warning This function does not check if the input statement is valid or if it has already been processed.
 *          It assumes that the input statement is valid and needs to be processed.
 *
 * @pre The input statement must be a valid SgStatement object.
 *
 * @post Internal maps are updated to reflect changes to the input statement.
 *
 * @note This function updates data structures such as macroExpansionMap, representativeWhitespaceStatementMap,
 *       and redundantlyMappedTokensToStatementMultimap. It also marks statements in the macro expansion
 *       as transformed and sets them to be output in code generation.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgStatement* statement = ...; // create a statement object
 *           SageInterface::resetInternalMapsForTargetStatement(statement);
 *          @endcode
 */
/**
 * @fn void SageInterface::convertFunctionDefinitionsToFunctionPrototypes(SgNode* node)
 *
 * @brief Converts a list of function definitions to their corresponding function prototypes.
 *
 * This function takes an SgNode representing the source code and converts all 
 * function definitions within it into function prototypes. It does this by first
 * generating a list of function declarations, then iterating over each one and 
 * replacing the defining declaration with its prototype equivalent.
 *
 * @param node The SgNode representing the source code to convert.
 *              Must not be NULL and must represent valid source code.
 *
 * @return None. This function does not return any value.
 *
 * @warning If the input node is NULL or represents invalid source code, 
 *          this function will terminate with an assertion failure.
 *
 * @pre The input node must not be NULL and must represent valid source code.
 *      All function declarations within the node's subtree must have a defining declaration.
 *
 * @post All function definitions within the input node's subtree are replaced by their prototype equivalents.
 *
 * @note This function uses the ROSE_ASSERT macro to enforce its preconditions. 
 *       If an assertion fails, the program will terminate immediately.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* node = ...; // obtain an SgNode representing some source code
 *           SageInterface::convertFunctionDefinitionsToFunctionPrototypes(node);
 *          @endcode
 */
/**
 * @fn SageInterface::replaceDefiningFunctionDeclarationWithFunctionPrototype ( SgFunctionDeclaration* functionDeclaration )
 *
 * @brief Replaces a defining function declaration with a non-defining function prototype.
 *
 * This function takes a defining function declaration as input and returns the corresponding 
 * non-defining function prototype. It performs various operations such as building a new function 
 * prototype, matching associated modifiers, setting linkage and extern brace, and moving comments 
 * and preprocessing directives. The function also handles template instantiations and preserves 
 * static declarations.
 *
 * @param functionDeclaration A pointer to the defining function declaration to be replaced.
 *          Must not be NULL.
 *
 * @return A pointer to the non-defining function prototype if successful, otherwise NULL.
 *
 * @warning This function modifies the input function declaration and its associated comments and preprocessing directives.
 * 
 * @pre The input function declaration must be valid and not NULL.
 * 
 * @post The returned non-defining function prototype will have the same properties as the input defining function declaration,
 *        except for being a non-defining prototype. Any comments or preprocessing directives attached to the original
 *        function declaration will be moved to the new prototype.
 *
 * @note This function is used in the ROSE compiler infrastructure and may not be suitable for general use.
 *
 * 
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgFunctionDeclaration* definingDecl = ...; // assume a valid defining function declaration
 *           SgFunctionDeclaration* nonDefiningProto = SageInterface::replaceDefiningFunctionDeclarationWithFunctionPrototype(definingDecl);
 *           if (nonDefiningProto != NULL) {
 *               // use the new non-defining prototype
 *           }
 *          @endcode
 */
/**
 * @fn std::vector<SgFunctionDeclaration*> SageInterface::generateFunctionDefinitionsList(SgNode* node)
 *
 * @brief Generates a list of function definitions from an AST subtree.
 *
 * This function traverses the Abstract Syntax Tree (AST) subtree rooted at the given SgNode and collects all function declarations. 
 * It uses a preorder traversal to visit each node in the tree, checking if it is a function declaration. If so, it adds the declaration to the list of functions.
 *
 * The purpose of this function is to support outlined function definitions by generating a list of functions that can be used for outlining.
 *
 * @param node The root node of the AST subtree to traverse.
 * 
 * @return A vector of SgFunctionDeclaration pointers representing the function declarations found in the AST subtree.
 * 
 * @warning This function assumes that the input node is a valid SgNode and that the AST subtree rooted at this node has been properly constructed. 
 *
 * @pre The input node must be non-null and represent a valid SgNode in the AST.
 *
 * @post The returned vector will contain all function declarations found in the AST subtree rooted at the input node.
 *
 * @note This function uses a preorder traversal to visit each node in the AST subtree. 
 *       It checks if each node is a function declaration and adds it to the list of functions if so.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *              // Create an instance of SageInterface
 *              SageInterface sage;
 * 
 *              // Get the root node of the AST subtree
 *              SgNode* rootNode = ...;  // Replace with actual code to get the root node
 * 
 *              // Generate the list of function definitions
 *              std::vector<SgFunctionDeclaration*> functions = sage.generateFunctionDefinitionsList(rootNode);
 * 
 *              // Use the generated list of functions as needed
 *          @endcode
 */
/**
 * @fn SgNondefiningFunctionDeclaration* buildNondefiningFunctionDeclaration(SgFunctionDeclaration* functionDeclaration, SgType* return_type, SgParameterList* param_list, SgScopeStatement* scope, std::vector<SgPythonDecorator*> python_decoratorList, bool buildTemplateInstantiation = false, SgTemplateArgumentList* templateArgumentsList = NULL)
 * @brief Builds a non-defining function declaration from a given function declaration.
 *
 * This function takes in various parameters such as the name of the function,
 * return type, parameter list, scope, and Python decorator list to construct a
 * non-defining function declaration. It also handles template instantiations.
 *
 * @param functionDeclaration The input function declaration.
 * @param buildTemplateInstantiation A flag indicating whether to build a template instantiation.
 * @param templateArgumentsList A pointer to the template arguments list (optional).
 * @return A pointer to the built non-defining function declaration, or NULL if it cannot be constructed.
 */

/**
 * @fn int fixVariableReferences(SgNode* root) 
 * @brief Fixes variable references in a given AST.
 *
 * This function takes an SgNode as input and fixes any variable references within it.
 * It does this by looking up the symbol for each variable reference in the parent scopes
 * of the node, and replacing the original symbol with the found one.
 *
 * @param root The root node of the AST to fix variable references in.
 * @return The number of fixed variable references.
 */

/**
 * @fn void SageInterface::fixVariableDeclaration(SgVariableDeclaration* varDecl, SgScopeStatement* scope)
 *
 * @brief Fixes variable declarations in the Abstract Syntax Tree (AST) by setting their scopes and symbols correctly.
 *
 * This function takes a variable declaration and its corresponding scope as input, and fixes the variable's scope 
 * and symbol table entries. It iterates over all initializers in the variable declaration, sets their scopes to the 
 * required scope (which may be different from the current scope for C++), and updates the symbol table accordingly.
 *
 * @param varDecl The variable declaration to be fixed. Must not be NULL.
 * @param scope The scope statement corresponding to the variable declaration. Must not be NULL.
 *
 * @return None
 *
 * @warning This function assumes that the input variable declaration and scope are valid and correctly formed.
 *          It does not perform any error checking on these inputs.
 *
 * @pre varDecl must not be NULL, and scope must not be NULL.
 * @post The scopes of all initializers in the variable declaration have been set to the required scope,
 *       and their symbol table entries have been updated accordingly.
 *
 * @note This function is used to fix variable declarations in the AST, which may have incorrect scopes or symbol 
 *       table entries due to the complexities of C++ syntax. It is typically called during the AST construction 
 *       process.
 *
 * @example This example demonstrates how to call this function to fix a variable declaration:
 *          SgVariableDeclaration* varDecl = ...; // obtain a variable declaration
 *          SgScopeStatement* scope = ...; // obtain the corresponding scope statement
 *          SageInterface::fixVariableDeclaration(varDecl, scope);
 */
/**
* @fn void SageInterface::fixStructDeclaration(SgNode* decl) 
* @brief Fix struct declaration in SageInterface.
*
* This function fixes a struct declaration by adding class symbols to the scope
* and setting up the parent and scope for the declarations. It also checks if
* the type of the non-defining declaration is a SgClassType IR node.
*
* @param decl A pointer to the declaration that needs to be fixed.
*/

/**
 * @fn void SageInterface::fixClassDeclaration(SgClassDeclaration* classDecl, SgScopeStatement* scope)
 *
 * @brief Fixes the declaration of a C++ class by applying necessary modifications.
 *
 * This function takes a C++ class declaration and its surrounding scope as input,
 * and applies fixes to ensure that the class declaration is correct and consistent
 * with the Sage compiler's expectations. The exact nature of these fixes may vary
 * depending on the specific requirements of the Sage compiler and the characteristics
 * of the input code.
 *
 * @param classDecl A pointer to the SgClassDeclaration object representing the C++ class declaration to be fixed.
 *                  Must not be NULL.
 *
 * @param scope A pointer to the SgScopeStatement object representing the surrounding scope of the class declaration.
 *              Must not be NULL.
 *
 * @return None
 *
 * @warning This function may modify the input class declaration and/or its surrounding scope in place.
 *
 * @pre The input class declaration and its surrounding scope must be valid and well-formed.
 *
 * @post The modified class declaration and/or its surrounding scope are guaranteed to be valid and consistent with the Sage compiler's expectations.
 *
 * @note This function is part of the SageInterface class, which provides a set of utility functions for working with C++ code in the context of the Sage compiler.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgClassDeclaration* classDecl = ...; // obtain a valid class declaration object
 *           SgScopeStatement* scope = ...; // obtain a valid surrounding scope object
 *           SageInterface sage;
 *           sage.fixClassDeclaration(classDecl, scope);
 *          @endcode
 */
/**
 * @fn void SageInterface::fixNamespaceDeclaration(SgNamespaceDeclarationStatement* structDecl, SgScopeStatement* scope)
 *
 * @brief Fixes namespace declaration by setting parent and scope for the given declarations.
 *
 * This function is used to correct the AST representation of a C++ program. It takes two parameters: 
 * a pointer to an SgNamespaceDeclarationStatement representing the namespace declaration to be fixed, 
 * and a pointer to an SgScopeStatement representing the scope in which this declaration should reside. 
 * The function ensures that both the defining and non-defining declarations of the namespace have their parent set to the given scope.
 * Additionally, it checks if the namespace symbol is already present in the scope's symbol table; if not, it creates a new SgNamespaceSymbol and inserts it into the scope.
 *
 * @param structDecl The pointer to the SgNamespaceDeclarationStatement representing the namespace declaration to be fixed. Must not be NULL.
 * @param scope The pointer to the SgScopeStatement representing the scope in which this declaration should reside. Must not be NULL.
 *
 * @return None
 *
 * @warning This function modifies the input AST by setting parents and scopes of declarations, and inserting symbols into scopes.
 *
 * @pre structDecl must be a valid pointer to an SgNamespaceDeclarationStatement.
 * @pre scope must be a valid pointer to an SgScopeStatement.
 * @pre The given namespace declaration must have at least one non-defining declaration.
 *
 * @post The parent of both the defining and non-defining declarations is set to the given scope.
 * @post If the namespace symbol was not already present in the scope's symbol table, a new SgNamespaceSymbol is created and inserted into the scope.
 *
 * @note This function assumes that the input AST has been properly constructed before calling this function. 
 *       It does not perform any checks for the correctness of the input AST beyond those specified in the preconditions.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNamespaceDeclarationStatement* namespaceDecl = ...; // obtain a pointer to an SgNamespaceDeclarationStatement
 *           SgScopeStatement* scope = ...; // obtain a pointer to an SgScopeStatement
 *           SageInterface::fixNamespaceDeclaration(namespaceDecl, scope);
 *          @endcode
 */
/**
 * @fn void SageInterface::fixLabelStatement(SgLabelStatement* stmt, SgScopeStatement* scope)
 *
 * @brief Fixes the label statement by setting its scope correctly.
 *
 * This function adjusts the scope of a given label statement to ensure it is
 * properly inserted into the symbol table. In languages other than Ada,
 * the label symbol should be at the function level, while in Ada, it should be
 * at the innermost scope.
 *
 * @param stmt The SgLabelStatement that needs its scope fixed.
 *             Must not be NULL and must be a valid SgLabelStatement.
 *
 * @param scope The SgScopeStatement that is expected to contain the label statement.
 *              Should ideally be a nested scope within a function definition,
 *              but can also be an SgFunctionDefinition itself.
 *
 * @return None
 *
 * @warning If the input scope is not a valid SgScopeStatement or if the label
 *          statement does not have a valid name, the behavior of this function
 *          is undefined.
 *
 * @pre The input stmt must be a non-NULL and valid SgLabelStatement. The input
 *      scope should ideally be a nested scope within an SgFunctionDefinition,
 *      but it can also be an SgFunctionDefinition itself.
 *
 * @post The label statement's scope will be correctly set to either the function
 *       level (for non-Ada languages) or the innermost scope (for Ada). If the label
 *       symbol does not exist in the scope, a new one will be created and inserted.
 *
 * @note This function assumes that the input label statement has already been
 *       correctly parsed and is syntactically valid. It also assumes that the
 *       input scope is a valid SgScopeStatement.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create an SgLabelStatement with a name
 *           SgName label_name = "my_label";
 *           SgLabelStatement* stmt = new SgLabelStatement(label_name);
 *
 *           // Get the current scope (assuming it's a valid SgScopeStatement)
 *           SgScopeStatement* scope = get_current_scope();
 *
 *           // Fix the label statement's scope
 *           SageInterface::fixLabelStatement(stmt, scope);
 *          @endcode
 */
/**
 * @fn void SageInterface::setFortranNumericLabel(SgStatement* stmt, int label_value,
 *                                              SgLabelSymbol::label_type_enum label_type, SgScopeStatement* label_scope)
 *
 * @brief Sets a Fortran numeric label for the given statement.
 *
 * This function associates a numeric label with a given statement in a Fortran program.
 * It takes into account the type of label (start or end) and the scope in which the label is defined.
 *
 * The label value must be between 1 and 99999, as specified by the Fortran standard.
 * If the label scope is not provided, it defaults to the enclosing function definition.
 *
 * @param stmt The statement for which the numeric label is to be set. Must not be NULL.
 * @param label_value The numeric value of the label. Must be between 1 and 99999.
 * @param label_type The type of label (start or end). Defaults to SgLabelSymbol::e_start_label_type if not provided.
 * @param label_scope The scope in which the label is defined. If NULL, defaults to the enclosing function definition.
 *
 * @return None
 *
 * @warning If a label with the same value already exists in the given scope, an error message is printed and the program aborts.
 *
 * @pre stmt must not be NULL, label_value must be between 1 and 99999, and label_scope must be a valid SgScopeStatement pointer.
 *
 * @post The statement has been associated with a numeric label of the specified type and value in the given scope.
 *
 * @note This function modifies the abstract syntax tree (AST) of the program by inserting a new label symbol.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgStatement* stmt = ...; // some statement in the Fortran program
 *           int label_value = 10;
 *           SgLabelSymbol::label_type_enum label_type = SgLabelSymbol::e_start_label_type;
 *           SgScopeStatement* label_scope = getEnclosingFunctionDefinition(stmt);
 *           SageInterface::setFortranNumericLabel(stmt, label_value, label_type, label_scope);
 *          @endcode
 */
/**
 * @fn int SageInterface::suggestNextNumericLabel(SgFunctionDefinition* func_def)
 *
 * @brief Suggests a numeric label value for a Fortran 77 function.
 *
 * This function scans the symbol table of the given function definition to
 * find the maximum numeric label value used and suggests a new label value by
 * adding 10 to the maximum found. The suggested label is ensured to be within the
 * valid range for Fortran 77 labels (i.e., not exceeding 5 digits).
 *
 * @param func_def A pointer to an SgFunctionDefinition object representing the
 *                 function for which a numeric label value is to be suggested.
 *                 Must not be NULL. The function must also be in Fortran language.
 *
 * @return A suggested numeric label value, at least 10 greater than the maximum
 *         existing label value found in the function's symbol table.
 *
 * @warning If no labels are found in the function's symbol table, a default value of 10 is returned.
 *
 * @pre The input SgFunctionDefinition object must not be NULL and must represent a Fortran language function.
 *
 * @post The returned label value will be at least 10 greater than any existing label value in the function's symbol table.
 *
 * @note This function assumes that the input function definition is valid and has been parsed correctly.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgFunctionDefinition* func_def = ...; // assume a valid function definition
 *           int next_label = SageInterface::suggestNextNumericLabel(func_def);
 *           cout << "Suggested next label: " << next_label << endl;
 *          @endcode
 */
