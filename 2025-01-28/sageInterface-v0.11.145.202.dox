 *           SgType* enum_type = ...; // assume a valid SgType object representing an enumeration
 *           SgType* underlying_type = UnderlyingType(enum_type);
 *           if (underlying_type != NULL) {
 *               // do something with the underlying type
 *           } else {
 *               // handle error or invalid input
 *           }
