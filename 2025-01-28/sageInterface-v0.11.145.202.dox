/**
 * @fn SgNamedType* SageInterface::getDeclaredType(const SgDeclarationStatement* declaration)
 *
 * @brief Retrieves the declared type of a given declaration statement.
 *
 * This function dispatches to the DeclaredType struct to obtain the declared type
 * associated with the provided declaration statement. The DeclaredType struct is 
 * responsible for determining the correct type based on the input declaration.
 *
 * @param declaration A pointer to an SgDeclarationStatement object representing the 
 *                     declaration for which the type should be retrieved.
 *
 * @return A pointer to an SgNamedType object representing the declared type of the 
 *         input declaration statement, or nullptr if no type is found.
 *
 * @warning The function does not perform any error checking on the input declaration. 
 *          It assumes that the provided declaration is valid and correctly formed.
 *
 * @pre The input declaration must be a valid SgDeclarationStatement object.
 *
 * @post The returned type is either an SgNamedType object or nullptr, depending on whether
 *       a declared type was found for the input declaration.
 *
 * @note This function relies on the DeclaredType struct to perform the actual type 
 *       retrieval. As such, its behavior and results are directly dependent on the 
 *       implementation of the DeclaredType struct.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *            SgNamedType* declaredType = SageInterface::getDeclaredType(declaration);
 *            if (declaredType != nullptr) {
 *              // Use the retrieved type as needed
 *            } else {
 *              // Handle the case where no type was found
 *            }
 *          @endcode
 */
/**
 * @fn string SageInterface::generateUniqueNameForUseAsIdentifier(SgDeclarationStatement* declaration)
 *
 * @brief Generates a unique name for use as an identifier.
 *
 * This function generates a unique name that can be used as an identifier, 
 * typically for a variable or function. It uses the local node to name map and 
 * local name to node map maintained by the SageInterface class to ensure uniqueness.
 *
 * The function first checks if the input declaration is already in the local 
 * node to name map. If it is, the corresponding unique name is returned. Otherwise, 
 * it tries to find a defining declaration for the input declaration and uses that 
 * to generate a unique name. If no defining declaration can be found, it uses the 
 * first non-defining declaration instead.
 *
 * @param declaration The SgDeclarationStatement object for which a unique name is to be generated.
 *                     Must not be NULL.
 *
 * @return A string representing the unique name generated for the input declaration.
 *
 * @warning If the declaring declaration cannot be found in the local node to name map, 
 *          this function will use the first non-defining declaration instead. This may 
 *          lead to unexpected behavior if the non-defining declaration is not a valid 
 *          identifier.
 *
 * @pre The input declaration must not be NULL and must have been previously inserted into 
 *      the local node to name map or have a defining declaration that has been inserted.
 *
 * @post A unique name will be generated for the input declaration, which can then be used as an identifier.
 *
 * @note This function is not thread-safe, as it relies on the state of the SageInterface class.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgDeclarationStatement* decl = ...; // Obtain a declaration statement object
 *           string uniqueName = SageInterface::generateUniqueNameForUseAsIdentifier(decl);
 *           cout << "Generated unique name: " << uniqueName << endl;
 *          @endcode
 */
/**
 * @fn string SageInterface::generateUniqueNameForUseAsIdentifier_support(SgNode* declaration)
 * @brief Generates a unique name for use as an identifier in code generation.
 *
 * This function takes into account the declaration type and scope to create
 * a unique name that can be used as an identifier. It also detects name collisions
 * and appends a count to the generated name if necessary.
 *
 * @param declaration The declaration object from which to generate the unique name.
 * @return A string representing the generated unique name.
 */

/**
 * @fn SageInterface::computeUniqueNameForUseAsIdentifier(SgNode* astNode)
 *
 * @brief Computes a unique name for use as an identifier in the Abstract Syntax Tree (AST).
 *
 * This function performs a pre-order traversal of the AST rooted at the given node
 * to uniquely name specific declarations (SgClassDeclaration and SgFunctionDeclaration IR nodes).
 * It uses a recursive algorithm to generate unique names.
 *
 * @param astNode The root node of the AST for which unique names are to be computed.
 *                 Must not be NULL. If the input node is not a valid AST node, undefined behavior occurs.
 *
 * @return None
 *
 * @warning The function modifies internal data structures (local_name_collision_map,
 *          local_name_to_node_map, and local_node_to_name_map) that are used to keep track of unique names.
 *
 * @pre astNode must be a valid non-NULL pointer to an SgNode in the AST.
 *       local_name_collision_map, local_name_to_node_map, and local_node_to_name_map must be empty.
 *
 * @post The function has performed a pre-order traversal of the AST rooted at astNode,
 *        and unique names have been assigned to specific declarations (SgClassDeclaration
 *        and SgFunctionDeclaration IR nodes) in the AST. Internal data structures
 *        local_name_collision_map, local_name_to_node_map, and local_node_to_name_map have been modified.
 *
 * @note This function is designed to be used within the SageInterface class and should not be called directly from outside the class.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* astNode = ...; // assume a valid AST node
 *           SageInterface sage;
 *           sage.computeUniqueNameForUseAsIdentifier(astNode);
 *          @endcode
 */
/**
 * @fn void SageInterface::reset_name_collision_map()
 *
 * @brief Resets the name collision maps to their initial state.
 *
 * This function clears all data structures used for tracking name collisions,
 * effectively resetting them to their initial empty state. It is typically
 * called when a new compilation unit or scope is entered, ensuring that any
 * previously recorded name collisions are discarded and do not affect the
 * processing of the new code segment.
 *
 * The function implements an O(1) operation as it simply clears three maps:
 * local_name_collision_map, local_name_to_node_map, and local_node_to_name_map,
 * without performing any additional computations or checks.
 *
 * @param None. This function does not take any parameters.
 *
 * @return None. This function does not return a value.
 *
 * @warning The caller is responsible for ensuring that this function is called
 *          in the correct context, as resetting these maps prematurely can
 *          lead to incorrect results or errors during further processing.
 *
 * @precondition None. There are no preconditions for calling this function.
 *
 * @postcondition All name collision maps have been reset to their initial state.
 *
 * @note This function is part of the internal implementation of SageInterface and
 *       should not be called directly from external code without careful consideration
 *       of its implications on the overall processing workflow.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Assuming 'si' is an instance of SageInterface
 *           si.reset_name_collision_map();
 *          @endcode
 */
