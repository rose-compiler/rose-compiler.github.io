/**
 * @fn bool SageInterface::loopInterchange(SgForStatement* loop, size_t depth, size_t lexicoOrder)
 *
 * @brief Interchanges loops in a loop nest based on a given lexicographical order.
 *
 * This function reorders the loops in a loop nest according to a specified
 * lexicographical order. The input loop must have at least two levels and the
 * lexicographical order must be less than the factorial of the depth of the loop
 * nest. The function first verifies the input parameters, then saves the headers
 * of the loops in the nest, converts the lexicographical number to a permutation
 * order array, and finally rewrites the loop nest based on this permutation.
 *
 * @param loop The SgForStatement representing the loop nest to be interchanged.
 *             Must not be NULL.
 * @param depth The size_t representing the depth of the loop nest. Must be greater than 1.
 * @param lexicoOrder The size_t representing the lexicographical order of the permutation.
 *                    Must be less than the factorial of the depth and not equal to 0.
 *
 * @return True if the interchange is successful, false otherwise.
 *
 * @warning This function may modify the input loop nest and its children loops.
 *
 * @pre The input loop must have at least two levels and the lexicographical order
 *      must be less than the factorial of the depth of the loop nest.
 *
 * @post The loop nest is modified according to the specified permutation.
 *
 * @note This function assumes that the input loop has n perfectly-nested children
 *       loops inside, where n is the depth of the loop nest.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create a loop nest with two levels
 *           SgForStatement* loop = ...;
 *           size_t depth = 2;
 *           size_t lexicoOrder = 1; // interchange the loops in lexicographical order 1
 *
 *           bool success = SageInterface::loopInterchange(loop, depth, lexicoOrder);
 *           if (success) {
 *             // The loop nest has been interchanged successfully
 *           } else {
 *             // Error handling
 *           }
 *          @endcode
 */
/**
 * @fn bool SageInterface::loopTiling(SgForStatement* loopNest, size_t targetLevel, size_t tileSize)
 *
 * @brief Performs loop tiling on a given loop nest.
 *
 * This function takes a loop nest as input and performs loop tiling by inserting
 * a controlling loop around the top loop nest. It normalizes the target loop,
 * grabs its essential header information, and rewrites the lower and upper bounds
 * of the target loop to achieve tiling.
 *
 * @param loopNest The loop nest to be tiled.
 * @param targetLevel The level at which to perform tiling.
 * @param tileSize The size of the tile.
 *
 * @return True if the operation is successful, false otherwise.
 */

/**
 * @details This function performs the following steps:
 *   1. Normalizes the target loop by ensuring it has a single entry and exit point.
 *   2. Grabs the essential header information of the target loop, including its lower
 *       and upper bounds.
 *   3. Inserts a controlling loop around the top loop nest to achieve tiling.
 *   4. Rewrites the lower and upper bounds of the target loop based on the tile size.
 *
 * @note This function assumes that the input loop nest is well-formed and can be
 *       successfully tiled. It does not perform any error checking or handling.
 */

/**
 * @warning This function modifies the input loop nest in-place. The original loop
 *           nest is lost after tiling.
 */
