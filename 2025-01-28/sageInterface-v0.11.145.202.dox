 */
/**
 * @fn void SageInterface::setSourcePositionForTransformation(SgNode *root)
 *
 * @brief Sets the source position for a given SgNode as a transformation.
 *
 * This function sets the source position of the input SgNode and all its children 
 * to indicate that they are part of a transformation. The function is typically used
 * in the context of source code transformations, where the original source code 
 * position needs to be preserved after modifications.
 *
 * @param root The SgNode for which the source position is to be set as a transformation.
 *              Must not be NULL.
 *
 * @return None
 *
 * @warning This function should only be called when the mode is transformation. 
 *          Otherwise, it may lead to incorrect results or undefined behavior.
 *
 * @pre The input SgNode must not be NULL.
 *
 * @post The source position of the input SgNode and all its children are set as a transformation.
 *
 * @note This function is deprecated in favor of setSourcePositionAtRootAndAllChildrenAsTransformation().
 *       However, it can still be used for compatibility reasons or when working with legacy code.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* root = ...; // obtain the root node
 *           SageInterface::setSourcePositionForTransformation(root);
 *          @endcode
 */
/**
 * @fn bool SageInterface::insideSystemHeader(SgLocatedNode* node)
 *
 * @brief Checks if a given SgLocatedNode is inside a system header file.
 *
 * This function determines whether the specified SgLocatedNode lies within
 * a system header file. It checks for specific paths in the build and install
 * trees, as well as the standard system headers directory (/usr/include).
 *
 * @param node The SgLocatedNode to be checked. Must not be NULL.
 *
 * @return True if the node is inside a system header file, false otherwise.
 *
 * @warnings This function assumes that the input node's file information is
 *            available and correctly set up. If this is not the case, the
 *            function may return incorrect results or crash.
 *
 * @preconditions The input node must not be NULL. Its file information should
 *                 be properly initialized.
 *
 * @postconditions None.
 *
 * @note This function uses a simple string search approach to identify system
 *       headers. It may not cover all possible cases and might need adjustments
 *       for specific use scenarios.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgLocatedNode* node = ...; // initialize the node
 *           if (SageInterface::insideSystemHeader(node)) {
 *             cout << "The node is inside a system header file." << endl;
 *           } else {
 *             cout << "The node is not inside a system header file." << endl;
 *           }
 *          @endcode
 */
/**
 * @fn bool SageInterface::insideHeader(SgLocatedNode* node)
 *
 * @brief Checks if a given SgLocatedNode is from a header file.
 *
 * This function determines whether the input node originates from a header
 * file by checking its filename against a map of processed header files.
 *
 * The check involves looking up the filename in the EDG_ROSE_Translation::edg_include_file_map,
 * which stores all header files encountered during the generation of the ROSE AST.
 *
 * @param node The SgLocatedNode to be checked. Must not be NULL.
 *
 * @return True if the node is from a header file, false otherwise.
 *
 * @warning This function does not perform any error checking on the input node.
 *          It assumes that the node has already been validated and is of type SgLocatedNode.
 *
 * @pre The EDG_ROSE_Translation::edg_include_file_map must be populated with header files processed during ROSE AST generation.
 *
 * @post The function does not modify any external state, but returns a boolean value indicating whether the node is from a header file.
 *
 * @note This function relies on the EDG_ROSE_Translation::edg_include_file_map being up-to-date and accurate. If this map is incomplete or outdated, the results of this function may be incorrect.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgLocatedNode* node = ...; // obtain a valid SgLocatedNode instance
 *           if (SageInterface::insideHeader(node)) {
 *               printf("Node is from a header file.\n");
 *           } else {
 *               printf("Node is not from a header file.\n");
 *           }
 *          @endcode
 */
/**
 * @fn SgSymbol* SageInterface::lookupSymbolInParentScopesIgnoringAliasSymbols(const SgName & name, SgScopeStatement *currentScope, SgTemplateParameterPtrList* templateParameterList, SgTemplateArgumentPtrList* templateArgumentList)
 *
 * @brief Looks up a symbol in parent scopes, ignoring alias symbols.
 *
 * This function performs a lookup for the given symbol name in the current scope
 * and its parent scopes, excluding any alias symbols. It takes into account
 * template parameters and arguments during the lookup process.
 *
 * The function iterates through the scopes, starting from the current scope,
 * and checks if the symbol is present in each scope's symbol table. If an
 * alias symbol is found, it is ignored and the search continues in the parent
 * scope.
 *
 * @param name The name of the symbol to look up.
 * @param currentScope The current scope where the lookup starts.
 * @param templateParameterList A list of template parameters (optional).
 * @param templateArgumentList A list of template arguments (optional).
 *
 * @return A pointer to the found symbol, or NULL if not found.
 *
 * @warning If the symbol is not found in any parent scope, a warning message
 *          will be printed indicating that the specified name could not be
 *          located in any outer symbol table.
 *
 * @pre The currentScope parameter must not be NULL.
 *
 * @post The returned symbol pointer may be NULL if the symbol is not found.
 *
 * @note This function does not support lookup of alias symbols. If an alias
 *       symbol is encountered during the search, it will be ignored and the
 *       search will continue in the parent scope.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgName name("mySymbol");
 *           SgScopeStatement* currentScope = SageBuilder::topScopeStack();
 *           SgTemplateParameterPtrList* templateParameterList = NULL;
 *           SgTemplateArgumentPtrList* templateArgumentList = NULL;
 *
 *           SgSymbol* symbol = SageInterface::lookupSymbolInParentScopesIgnoringAliasSymbols(name, currentScope, templateParameterList, templateArgumentList);
 *
 *           if (symbol != NULL) {
 *               // Symbol found, process it
 *           } else {
 *               // Symbol not found, handle the case
 *           }
 *          @endcode
 */
/**
 * @fn SgSymbol* SageInterface::lookupSymbolInParentScopes(const SgName &  name, SgScopeStatement *cscope, SgTemplateParameterPtrList* templateParameterList, SgTemplateArgumentPtrList* templateArgumentList)
 *
 * @brief Looks up a symbol in the parent scopes of a given scope.
 *
 * This function searches for a symbol with the given name in the parent scopes
 * of the provided scope. It traverses the scope hierarchy upwards until it finds
 * the symbol or reaches the global scope. The search is performed using the
 * provided template parameter and argument lists to resolve any template
 * dependencies.
 *
 * @param name The name of the symbol to look up.
 * @param cscope The current scope in which to start looking for the symbol.
 *               If nullptr, the top scope on the stack is used instead.
 * @param templateParameterList A list of template parameters to use during lookup.
 *                               May be nullptr if not applicable.
 * @param templateArgumentList A list of template arguments to use during lookup.
 *                              May be nullptr if not applicable.
 *
 * @return The symbol found in one of the parent scopes, or nullptr if not found.
 *
 * @warning If the provided scope is nullptr and there are no scopes on the stack,
 *          this function will return nullptr without searching for the symbol.
 *
 * @pre cscope must be a valid pointer to an SgScopeStatement object, or nullptr.
 *      templateParameterList and templateArgumentList may be nullptr if not applicable.
 *
 * @post The returned symbol is either the one found in one of the parent scopes,
 *       or nullptr if not found. If cscope was nullptr, the top scope on the stack
 *       was used as the starting point for the search.
 *
 * @note This function does not modify the provided scope or its contents.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgScopeStatement* currentScope = ...; // obtain a valid scope pointer
 *           const SgName& symbolName = "mySymbol"; // define the name of the symbol to look up
 *           SgTemplateParameterPtrList* templateParams = nullptr; // no template parameters in this example
 *           SgTemplateArgumentPtrList* templateArgs = nullptr; // no template arguments in this example
 *
 *           SgSymbol* foundSymbol = SageInterface::lookupSymbolInParentScopes(symbolName, currentScope, templateParams, templateArgs);
 *
 *           if (foundSymbol != nullptr) {
 *               // symbol was found, process it accordingly
 *           } else {
 *               // symbol was not found, handle the error case
 *           }
 *          @endcode
 */
/**
 * @fn SageInterface::lookupVariableSymbolInParentScopes(const SgName & name, SgScopeStatement *cscope)
 *
 * @brief Looks up a variable symbol in the parent scopes of a given scope.
 *
 * This function searches for a variable symbol with the specified name
 * in the parent scopes of a given scope. If found, it returns the corresponding
 * SgVariableSymbol; otherwise, it returns NULL.
 *
 * The search starts from the given scope and moves up to the global scope,
 * checking each scope's symbol table for a matching variable symbol.
 *
 * Note that this function does not handle SgAliasSymbols correctly and may return
 * a SgClassSymbol instead of a SgVariableSymbol if both names are used. This is due
 * to the multi-map semantics of the symbol tables, which needs to be fixed in the future.
 *
 * @param name The name of the variable symbol to look up.
 * @param cscope The scope from which to start searching for the variable symbol.
 *               If NULL, the top scope stack will be used.
 *
 * @return The SgVariableSymbol corresponding to the specified name if found;
 *         otherwise, NULL.
 *
 * @warning This function may not work correctly with SgAliasSymbols and may return
 *          a SgClassSymbol instead of a SgVariableSymbol in some cases.
 *
 * @pre cscope is either NULL or a valid SgScopeStatement pointer.
 *
 * @post The returned symbol, if any, will be a valid SgVariableSymbol pointer.
 *
 * @note This function uses the lookup_variable_symbol() method of the SgScopeStatement class
 *       to search for the variable symbol in each scope's symbol table.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create a sample scope and variable symbol
 *           SgScopeStatement* scope = new SgScopeStatement();
 *           SgVariableSymbol* varSym = new SgVariableSymbol("myVar");
 *           scope->add_symbol(varSym);
 *
 *           // Look up the variable symbol in the parent scopes
 *           SgVariableSymbol* foundSym = SageInterface::lookupVariableSymbolInParentScopes("myVar", scope);
 *
 *           if (foundSym != NULL) {
 *               printf("Found variable symbol: %s\n", foundSym->get_name().c_str());
 *           } else {
 *               printf("Variable symbol not found.\n");
 *           }
 *          @endcode
 */

/**
 * @fn SgFunctionSymbol* SageInterface::lookupFunctionSymbolInParentScopes(const SgName & functionName, SgScopeStatement* currentScope)
 *
 * @brief Searches for a function symbol in parent scopes.
 *
 * This function searches for a function symbol with the given name in the
 * current scope and its parent scopes. It returns a pointer to the found
 * function symbol or NULL if not found.
 *
 * The search starts from the given current scope and traverses up the scope
 * hierarchy until it finds the function symbol or reaches the global scope.
 *
 * @param functionName The name of the function symbol to be searched for.
 * @param currentScope The current scope to start searching from. If NULL, the top scope on the stack is used.
 *
 * @return A pointer to the found function symbol or NULL if not found.
 *
 * @warning This function can return NULL if the function symbol is not found.
 *          It returns NULL when the function symbol is not defined in any of the parent scopes.
 *
 * @pre The current scope must be non-NULL, unless it is explicitly set to NULL to use the top scope on the stack.
 *
 * @post If a function symbol is found, its pointer is returned. Otherwise, NULL is returned.
 *
 * @note This function uses a recursive algorithm to traverse the scope hierarchy.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgName functionName = "myFunction";
 *           SgScopeStatement* currentScope = SageBuilder::topScopeStack();
 *           SgFunctionSymbol* functionSymbol = SageInterface::lookupFunctionSymbolInParentScopes(functionName, currentScope);
 *           if (functionSymbol != NULL) {
 *               // Function symbol found
 *           } else {
 *               // Function symbol not found
 *           }
 *          @endcode
 */
/**
 * @fn SgFunctionSymbol* SageInterface::lookupFunctionSymbolInParentScopes(const SgName& functionName, const SgType* t, SgScopeStatement* currentScope)
 *
 * @brief Searches for a function symbol with the given name and type in the parent scopes of the current scope.
 *
 * This function traverses the parent scopes of the current scope to find a function symbol that matches the given name and type. It returns the first matching function symbol found, or NULL if no match is found.
 *
 * The search starts from the current scope and moves up the scope hierarchy until it reaches the global scope or a scope with no parent. If the current scope is NULL, the top scope of the stack is used as the starting point.
 *
 * @param functionName The name of the function symbol to search for.
 * @param t The type of the function symbol to search for.
 * @param currentScope The current scope to start searching from. If NULL, the top scope of the stack is used.
 *
 * @return The first matching function symbol found in the parent scopes, or NULL if no match is found.
 *
 * @warning This function may return NULL if the function symbol is not found in any of the parent scopes.
 *
 * @pre The current scope must be a valid SgScopeStatement object. If it is NULL, the top scope of the stack must be set.
 *
 * @post The returned function symbol is either a valid SgFunctionSymbol object or NULL.
 *
 * @note This function uses the ROSE_ASSERT macro to ensure that the current scope is not NULL before proceeding with the search.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create a new SageInterface object
 *           SageInterface sage;
 *           
 *           // Define a sample function name and type
 *           SgName functionName = "myFunction";
 *           const SgType* t = ...; // some valid type
 *           
 *           // Get the current scope (assuming it is not NULL)
 *           SgScopeStatement* currentScope = ...;
 *           
 *           // Search for the function symbol in the parent scopes
 *           SgFunctionSymbol* functionSymbol = sage.lookupFunctionSymbolInParentScopes(functionName, t, currentScope);
 *           
 *           // Check if the function symbol was found
 *           if (functionSymbol != NULL) {
 *               // Use the found function symbol as needed
 *           } else {
 *               // Handle the case where no matching function symbol is found
 *           }
 *          @endcode
 */
/**
 * @fn SageInterface::lookupTemplateFunctionSymbolInParentScopes(const SgName & functionName, SgFunctionType * ftype, SgTemplateParameterPtrList * tplparams, SgScopeStatement* currentScope)
 *
 * @brief Searches for a template function symbol in the parent scopes of the given scope.
 *
 * This function searches for a template function symbol with the given name and type
 * in the parent scopes of the provided scope. It traverses up the scope hierarchy until
 * it finds the symbol or reaches the topmost scope (global scope).
 *
 * @param functionName The name of the function to search for.
 * @param ftype The type of the function to search for.
 * @param tplparams The template parameters of the function to search for.
 * @param currentScope The scope in which to start searching. If NULL, the topmost
 *          scope on the stack is used as the starting point.
 *
 * @return A pointer to the found function symbol, or NULL if not found.
 *
 * @warning This function can return NULL if the function symbol is not found.
 *          This can happen when a function is referenced before it is defined (no
 *          prototype mechanism in Fortran is required).
 *
 * @pre The provided scope must be valid and non-NULL, unless the default search from
 *          top of StackScope is desired.
 *
 * @post If the function symbol is found, its pointer is returned. Otherwise, NULL is returned.
 *
 * @note This function uses a recursive approach to traverse up the scope hierarchy.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgName functionName = "myFunction";
 *           SgFunctionType* ftype = ...; // define the function type
 *           SgTemplateParameterPtrList* tplparams = ...; // define the template parameters
 *           SgScopeStatement* currentScope = ...; // define the starting scope
 *
 *           SgFunctionSymbol* functionSymbol = SageInterface::lookupTemplateFunctionSymbolInParentScopes(functionName, ftype, tplparams, currentScope);
 *
 *           if (functionSymbol != NULL) {
 *               printf("Found function symbol: %s\n", functionSymbol->get_name().c_str());
 *           } else {
 *               printf("Function symbol not found.\n");
 *           }
 *          @endcode
 */
/**
 * @fn SgFunctionSymbol* SageInterface::lookupTemplateMemberFunctionSymbolInParentScopes(const SgName & functionName, SgFunctionType * ftype, SgTemplateParameterPtrList * tplparams, SgScopeStatement* currentScope)
 *
 * @brief Looks up a template member function symbol in the parent scopes.
 *
 * This function searches for a template member function symbol with the given name and type
 * in the parent scopes of the provided scope. It returns the first matching symbol found,
 * or NULL if no match is found.
 *
 * The search starts from the current scope and traverses up the scope hierarchy until
 * a match is found or the global scope is reached.
 *
 * @param functionName The name of the function to look up.
 * @param ftype The type of the function to look up.
 * @param tplparams A list of template parameters for the function.
 * @param currentScope The scope in which to start the search. If NULL, the top scope on the stack is used.
 *
 * @return The looked-up function symbol, or NULL if not found.
 *
 * @warning This function can return NULL if the function symbol is not found.
 *          It returns NULL when the function symbol is not defined in any of the parent scopes.
 *
 * @pre The currentScope parameter must be a valid scope, or NULL to use the top scope on the stack.
 *
 * @post If a match is found, the returned function symbol will have the correct name and type.
 *
 * @note This function uses a recursive algorithm to traverse the scope hierarchy.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgName functionName("myFunction");
 *           SgFunctionType* ftype = ...; // define the function type
 *           SgTemplateParameterPtrList* tplparams = ...; // define the template parameters
 *           SgScopeStatement* currentScope = ...; // define the current scope
 *
 *           SgFunctionSymbol* symbol = SageInterface::lookupTemplateMemberFunctionSymbolInParentScopes(functionName, ftype, tplparams, currentScope);
 *
 *           if (symbol != NULL) {
 *               printf("Found function symbol: %s\n", symbol->get_name().str());
 *           } else {
 *               printf("Function symbol not found.\n");
 *           }
 *          @endcode
 */
/**
 * @fn SageInterface::lookupTemplateVariableSymbolInParentScopes (const SgName &  name, SgTemplateParameterPtrList * tplparams, SgTemplateArgumentPtrList* tplargs, SgScopeStatement *cscope)
 *
 * @brief Searches for a template variable symbol in the parent scopes of a given scope.
 *
 * This function performs a lookup for a template variable symbol with the specified
 * name and template parameters in the parent scopes of the provided scope. It traverses
 * up the scope hierarchy until it finds the symbol or reaches the global scope.
 *
 * @param name The name of the template variable symbol to be looked up.
 * @param tplparams A list of template parameter pointers, which may be NULL if not applicable.
 * @param tplargs A list of template argument pointers, which may be NULL if not applicable.
 * @param cscope The scope in which to start the lookup. If NULL, the top scope on the stack is used.
 *
 * @return A pointer to the found SgTemplateVariableSymbol, or NULL if not found.
 *
 * @warning This function does not handle cases where the input parameters are invalid or inconsistent.
 *
 * @pre The provided scope cscope must be non-NULL and valid.
 *
 * @post If a symbol is found, it will be returned. Otherwise, NULL will be returned.
 *
 * @note This function uses the SageBuilder::topScopeStack() to get the top scope if cscope is NULL.
 *       It also uses the ROSE_ASSERT macro to ensure that the scope is not NULL before proceeding.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *            SgName name("my_template_variable");
 *            SgTemplateParameterPtrList* tplparams = ...; // initialize with valid template parameters
 *            SgTemplateArgumentPtrList* tplargs = ...;   // initialize with valid template arguments
 *            SgScopeStatement* cscope = ...;           // initialize with a valid scope
 *
 *            SgTemplateVariableSymbol* symbol = SageInterface::lookupTemplateVariableSymbolInParentScopes(name, tplparams, tplargs, cscope);
 *
 *            if (symbol != NULL) {
 *               printf("Found template variable symbol: %s\n", name.str());
 *            } else {
 *               printf("Template variable symbol not found.\n");
 *            }
 *          @endcode
 */
/**
 * @fn SgClassSymbol* SageInterface::lookupClassSymbolInParentScopes(const SgName &name, SgScopeStatement *cscope, SgTemplateArgumentPtrList* templateArgumentList)
 *
 * @brief Looks up a class symbol in the parent scopes of a given scope.
 *
 * This function recursively searches for a class symbol with the given name
 * in the parent scopes of the provided scope. It resolves SgAliasSymbols to 
 * be a SgClassSymbol where the alias is of a SgClassSymbol.
 *
 * @param name The name of the class symbol to look up.
 * @param cscope The scope in which to start the search. If NULL, the top scope stack is used.
 * @param templateArgumentList A list of template arguments for the lookup.
 *
 * @return The found SgClassSymbol or NULL if not found.
 *
 * @warning The function may return a null pointer if the symbol is not found.
 *
 * @pre cscope must be a valid SgScopeStatement pointer, and name must be a valid SgName object.
 *
 * @post If the symbol is found, it will be returned; otherwise, NULL will be returned.
 *
 * @note This function uses a recursive algorithm to search for the class symbol in the parent scopes.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgScopeStatement* scope = ...;
 *           const SgName& name = ...;
 *           SgTemplateArgumentPtrList* templateArguments = ...;
 *           SgClassSymbol* symbol = SageInterface::lookupClassSymbolInParentScopes(name, scope, templateArguments);
 *           if (symbol != NULL) {
 *               // symbol found
 *           } else {
 *               // symbol not found
 *           }
 *          @endcode
 */
/**
 * @fn SgTypedefSymbol* SageInterface::lookupTypedefSymbolInParentScopes (const SgName &  name, SgScopeStatement *cscope)
 *
 * @brief Searches for a typedef symbol in the given scope and its parent scopes.
 *
 * This function looks up a typedef symbol with the specified name within the
 * provided scope and its parent scopes. It traverses the scope hierarchy until
 * it finds a matching symbol or reaches the global scope.
 *
 * The search is performed using a recursive approach, starting from the given
 * scope and moving upwards through the parent scopes. If the symbol is found,
 * it returns a pointer to the SgTypedefSymbol object representing the symbol.
 * Otherwise, it returns NULL.
 *
 * @param name The name of the typedef symbol to be searched for.
 * @param cscope The initial scope where the search begins. If NULL, the top scope
 *               in the stack is used as the starting point.
 *
 * @return A pointer to the SgTypedefSymbol object representing the found symbol,
 *         or NULL if no matching symbol is found.
 *
 * @note This function assumes that the provided scope and its parent scopes are
 *       valid and properly initialized. If the input scope is invalid, the
 *       behavior of this function is undefined.
 *
 * @warning The search may overflow if the scope hierarchy is too deep or if
 *          there are cycles in the scope graph.
 *
 * @pre The provided scope must be a valid SgScopeStatement object, and its parent
 *      scopes must also be valid. The name parameter must be a non-empty string.
 *
 * @post If the symbol is found, the returned pointer remains valid until the
 *       corresponding SgTypedefSymbol object is deleted or modified.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgScopeStatement* scope = ...; // obtain a valid scope
 *           SgName name("my_typedef");  // define the symbol name
 *           SgTypedefSymbol* symbol = SageInterface::lookupTypedefSymbolInParentScopes(name, scope);
 *           if (symbol != NULL) {
 *               // process the found symbol
 *           } else {
 *               // handle the case where no symbol is found
 *           }
 *          @endcode
 */
/**
 * @fn SgNonrealSymbol* SageInterface::lookupNonrealSymbolInParentScopes(const SgName &name, SgScopeStatement *cscope, SgTemplateParameterPtrList* templateParameterList, SgTemplateArgumentPtrList* templateArgumentList)
 *
 * @brief Searches for a non-real symbol in the given scope and its parent scopes.
 *
 * This function attempts to find a non-real symbol with the specified name within
 * the provided scope and its parent scopes. It uses the given template parameter
 * list and template argument list to resolve any template dependencies.
 *
 * The search starts from the given scope and traverses up the scope hierarchy until
 * it finds the symbol or reaches the global scope.
 *
 * @param name The name of the non-real symbol to be searched for.
 * @param cscope The initial scope where the search begins. If NULL, the top scope on the stack is used.
 * @param templateParameterList A list of template parameters to resolve any template dependencies.
 * @param templateArgumentList A list of template arguments to resolve any template dependencies.
 *
 * @return A pointer to the found non-real symbol, or NULL if not found.
 *
 * @warning The function may return a stale pointer if the symbol is deleted after it is looked up.
 *
 * @pre The provided scope and its parent scopes must be valid and properly initialized.
 *
 * @post The returned symbol pointer remains valid until the symbol is deleted or the scope is modified.
 *
 * @note This function uses the ROSE_ASSERT macro to ensure that the provided scope is not NULL.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgName name("my_symbol");
 *           SgScopeStatement* cscope = SageBuilder::topScopeStack();
 *           SgTemplateParameterPtrList templateParams;
 *           SgTemplateArgumentPtrList templateArgs;
 *
 *           SgNonrealSymbol* symbol = SageInterface::lookupNonrealSymbolInParentScopes(name, cscope, &templateParams, &templateArgs);
 *
 *           if (symbol != NULL) {
 *               // Use the found symbol
 *           } else {
 *               // Handle the case where the symbol is not found
 *           }
 *          @endcode
 */
/**
 * @fn SageInterface::lookupTemplateClassSymbolInParentScopes (const SgName &  name, SgTemplateParameterPtrList* templateParameterList, SgTemplateArgumentPtrList* templateArgumentList, SgScopeStatement *cscope)
 *
 * @brief Searches for a template class symbol in the parent scopes of a given scope.
 *
 * This function traverses the parent scopes of a given scope to find a template class
 * symbol that matches the provided name and template parameters. It uses a recursive
 * approach to search through all parent scopes until it finds a match or reaches the
 * global scope.
 *
 * @param name The name of the template class symbol to be searched for.
 * @param templateParameterList A list of template parameters associated with the symbol.
 * @param templateArgumentList A list of template arguments associated with the symbol.
 * @param cscope The scope in which to start searching for the symbol. If NULL, the top
 *               scope stack is used as the starting point.
 *
 * @return The found template class symbol, or NULL if no matching symbol is found.
 *
 * @warning This function may return a NULL pointer if no matching symbol is found.
 *
 * @pre The provided scope must not be NULL. If it is, the top scope stack will be used
 *      as the starting point for the search.
 *
 * @post The returned symbol will either be a valid SgTemplateClassSymbol or NULL.
 *
 * @note This function uses a recursive approach to traverse the parent scopes. It
 *       may cause a stack overflow if the scope hierarchy is very deep.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Search for a template class symbol in the parent scopes of the current scope
 *           SgTemplateClassSymbol* symbol = lookupTemplateClassSymbolInParentScopes(name, &templateParameterList, &templateArgumentList, cscope);
 *
 *           if (symbol != NULL) {
 *               printf("Found template class symbol: %s\n", symbol->get_name().c_str());
 *           } else {
 *               printf("No matching symbol found.\n");
 *           }
 *          @endcode
 */
/**
 * @fn SgEnumSymbol* SageInterface::lookupEnumSymbolInParentScopes(const SgName &name, SgScopeStatement *cscope)
 *
 * @brief Looks up an enum symbol in the given scope and its parent scopes.
 *
 * This function searches for an enum symbol with the given name in the provided scope
 * and its parent scopes. It returns a pointer to the found symbol or NULL if not found.
 *
 * The search algorithm traverses the scope hierarchy upwards, starting from the given
 * scope, until it finds the desired enum symbol or reaches the global scope.
 *
 * @param name The name of the enum symbol to be looked up.
 * @param cscope The scope in which to start the lookup. If NULL, the top scope on the stack is used.
 *
 * @return A pointer to the found enum symbol, or NULL if not found.
 *
 * @warning If the input scope is NULL and no scopes are available on the stack, a fatal error occurs.
 *
 * @pre The input name must be valid (not empty).
 * @post The returned symbol is either the found enum symbol or NULL.
 *
 * @note This function uses a recursive approach to traverse the scope hierarchy.
 *       It may cause a stack overflow if the scope hierarchy is very deep.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgScopeStatement* scope = ...; // obtain a valid scope
 *           SgName name("my_enum_symbol");
 *           SgEnumSymbol* symbol = SageInterface::lookupEnumSymbolInParentScopes(name, scope);
 *           if (symbol != NULL) {
 *               // use the found enum symbol
 *           } else {
 *               // handle the case where the symbol is not found
 *           }
 *          @endcode
 */
/**
 * @fn SgNamespaceSymbol* SageInterface::lookupNamespaceSymbolInParentScopes (const SgName &  name, SgScopeStatement *cscope)
 *
 * @brief Looks up a namespace symbol in the parent scopes.
 *
 * This function searches for a namespace symbol with the given name in the
 * current scope and its parent scopes. It returns the first matching symbol
 * found in the search order.
 *
 * The search order is as follows:
 * 1. Current scope: The function checks if the symbol exists in the current
 *    scope. If it does, the function returns the symbol immediately.
 * 2. Parent scopes: If the symbol is not found in the current scope, the function
 *    moves to the parent scope and repeats the search process until a match
 *    is found or there are no more parent scopes.
 *
 * @param name The name of the namespace symbol to look up.
 * @param cscope The current scope where the search starts. If NULL, the topmost
 *          scope in the scope stack is used as the starting point.
 *
 * @return A pointer to the namespace symbol if found; otherwise, returns NULL.
 *
 * @warning If the input scope (cscope) is NULL, the function uses the topmost
 *          scope in the scope stack as the starting point. This may lead to
 *          unexpected results if the scope stack is modified concurrently.
 *
 * @pre The input name must be a valid SgName object.
 * @post If a matching symbol is found, the returned pointer remains valid until
 *       the symbol is removed from its containing scope or the program terminates.
 *
 * @note This function uses a recursive approach to search for the symbol in the
 *       parent scopes. It may cause stack overflow if the scope hierarchy is too deep.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgScopeStatement* currentScope = ...;
 *           const SgName& nameToLookUp = ...;
 *           SgNamespaceSymbol* symbol = SageInterface::lookupNamespaceSymbolInParentScopes(nameToLookUp, currentScope);
 *           if (symbol != NULL) {
 *               // Use the found symbol
 *           } else {
 *               // Handle the case where the symbol is not found
 *           }
 *          @endcode
 */

/**
 * @fn int SageInterface::set_name(SgInitializedName* initializedNameNode, string new_name) 
 * @brief Sets a new name for an SgInitializedName node.
 *
 * This function sets a new name for an SgInitializedName node and updates all
 * associated SgVarRefExp nodes. It also marks the enclosing statement as modified.
 *
 * @param initializedNameNode The SgInitializedName node to rename.
 * @param new_name The new name for the SgInitializedName node.
 * @return 0 if successful, 1 otherwise.
 */

/**
 * @fn void SageInterface::outputGlobalFunctionTypeSymbolTable()
 *
 * @brief Outputs the global table of function type symbols.
 *
 * This function prints out the global table of function type symbols built during
 * the EDG/Sage translation phase. The table initially contains the EDG names of all
 * instantiated templates, which are later replaced with modified template names
 * (mangled names) by the AST fixup in a subsequent phase.
 *
 * @param None
 *
 * @return None
 *
 * @warning This function does not perform any error checking on its input parameters.
 *
 * @pre The global function type table must be initialized and populated before calling this function.
 *
 * @post The contents of the global function type table are printed to the output stream.
 *
 * @note This function uses the SgNode::get_globalFunctionTypeTable() method to access the global function type table, which is assumed to be non-null.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SageInterface::outputGlobalFunctionTypeSymbolTable();
 *          @endcode
 */
/**
 * @fn void SageInterface::outputLocalSymbolTables(SgNode* node)
 *
 * @brief Outputs local symbol tables for a given SgNode.
 *
 * This function traverses the abstract syntax tree (AST) rooted at the given SgNode
 * and outputs local symbol tables. It utilizes an AST traversal to visit each node
 * in the tree, allowing for the extraction and output of relevant information.
 *
 * The default traversal order is preorder, which provides a more uniform interface.
 *
 * @param node The root node of the abstract syntax tree to be traversed.
 *              Must not be null. The node's type and structure determine the
 *              specific local symbol tables that will be output.
 *
 * @return None
 *
 * @warning This function does not perform any error checking on the input node.
 *          It is assumed that the node is valid and properly initialized.
 *
 * @pre The input node must be a valid SgNode instance.
 *
 * @post Local symbol tables for the given node will have been output.
 *
 * @note The specific format and content of the output local symbol tables
 *       depend on the implementation details of the AST traversal.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* root = ...; // obtain a valid SgNode instance
 *           SageInterface::outputLocalSymbolTables(root);
 *          @endcode
 */
/**
 * @fn void SageInterface::rebuildSymbolTable(SgScopeStatement* scope)
 * @brief Rebuilds the symbol table from a given scope.
 *
 * This function iterates through the declarations in the scope and creates
 * symbols for each declaration. It handles different types of declarations,
 * such as variable definitions, function declarations, namespace declarations,
 * and more. The function also checks if a declaration is already present in the
 * symbol table and updates it accordingly.
 *
 * @param scope The scope from which to rebuild the symbol table.
 */

/**
 * @fn void SageInterface::clearUnusedVariableSymbols(SgNode* root /*= NULL */)
 *
 * @brief Clears unused variable symbols from the memory pool.
 *
 * This function removes SgVariableSymbol objects that are not referenced by any
 * nodes in the abstract syntax tree (AST) from the memory pool. It iterates over all
 * SgVariableSymbol objects and checks if their declarations have a type of 
 * SgTypeUnknown. If so, it further checks if the symbol is referenced by any nodes 
 * in the AST rooted at the specified "root" node. If not, the symbol is deleted.
 *
 * @param root The root node of the subtree to check for references to the variable symbols.
 *             Defaults to NULL, which means all SgVariableSymbol objects are checked.
 *
 * @return None
 *
 * @warning This function modifies the memory pool by deleting SgVariableSymbol objects.
 *
 * @pre The input "root" node must be a valid SgNode pointer, or NULL for a global check.
 *
 * @post The memory pool is modified to remove unused SgVariableSymbol objects.
 *
 * @note This function uses NodeQuery::queryMemoryPool() and NodeQuery::querySubTree()
 *       to iterate over the AST nodes. It also uses VariantVector to store the 
 *       results of these queries.
 *
 */
/**
 * @fn void fixupReferencesToSymbols(SgScopeStatement* this_scope, SgScopeStatement* copy_scope) 
 * @brief Fix up references to symbols in the given scope.
 * 
 * This function fixes up references to symbols in the given scope by replacing
 * the original symbol with a new one from the copy scope. It uses an edge pointer
 * replacement utility function to perform the replacement.
 * 
 * @param this_scope The original scope that needs to be fixed up.
 * @param copy_scope The copied scope that contains the new symbols.
 */
 
/**
 * @fn SgMemberFunctionDeclaration* SageInterface::getDefaultDestructor(SgClassDeclaration* classDeclaration)
 *
 * @brief Retrieves the default destructor of a given class declaration.
 *
 * This function searches for the default destructor within the members of a class definition. 
 * It iterates through each member and checks if it is a member function declaration with a special 
 * function modifier that indicates it is a destructor. If such a function is found, it is returned as 
 * the default destructor.
 *
 * @param classDeclaration The SgClassDeclaration for which to retrieve the default destructor.
 *                          Must not be NULL and should have a defining declaration.
 *
 * @return A pointer to the SgMemberFunctionDeclaration representing the default destructor of the given class declaration, or NULL if no such destructor is found.
 *
 * @warning If the input class declaration does not have a defining declaration, this function may not work as expected.
 *
 * @note This function performs assertions on its inputs and may terminate the program if they are invalid.
 *
 * @pre The input class declaration must be valid and should have a defining declaration.
 *
 * @post The returned default destructor is guaranteed to be a member of the given class declaration, but may be NULL if no such destructor exists.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgClassDeclaration* classDecl = ...; // obtain a valid SgClassDeclaration object
 *           SgMemberFunctionDeclaration* defaultDestructor = SageInterface::getDefaultDestructor(classDecl);
 *           if (defaultDestructor != NULL) {
 *             printf("Default destructor found: %s\n", defaultDestructor->unparseToString().c_str());
 *           }
 *          @endcode
 */
/**
 * @fn SgMemberFunctionDeclaration* SageInterface::getDefaultConstructor(SgClassDeclaration* classDeclaration)
 *
 * @brief Retrieves the default constructor of a given class declaration.
 *
 * This function searches for the default constructor within a class definition
 * and returns it. If no default constructor is found, or if the input class declaration
 * does not have a defining declaration (i.e., it's a forward declaration), the 
 * function returns NULL.
 *
 * The search algorithm iterates through all members of the class definition 
 * to find a member function that has its special function modifier set as a constructor.
 *
 * @param classDeclaration A pointer to an SgClassDeclaration object representing
 *                         the class for which to retrieve the default constructor.
 *                         Must not be NULL.
 *
 * @return A pointer to the SgMemberFunctionDeclaration object representing the 
 *         default constructor of the input class declaration, or NULL if no such 
 *         constructor exists or if the input is invalid.
 *
 * @warning The function does not verify whether the found constructor has no arguments
 *          (i.e., it's a true default constructor) or whether it's private/public. It 
 *          only checks for the presence of a constructor.
 *
 * @pre The input class declaration must be non-NULL and have a defining declaration.
 *
 * @post If a default constructor is found, its parent pointer points to the class definition.
 *
 * @note This function does not handle cases where multiple constructors are present,
 *       nor does it verify whether the found constructor has any side effects or 
 *       whether it's actually callable.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgClassDeclaration* classDecl = ...; // obtain a class declaration
 *           SgMemberFunctionDeclaration* defaultCtor = SageInterface::getDefaultConstructor(classDecl);
 *           if (defaultCtor != NULL) {
 *             printf("Default constructor found: %s\n", defaultCtor->get_name().str());
 *           } else {
 *             printf("No default constructor found.\n");
 *           }
 *          @endcode
 */
/**
 * @fn bool SageInterface::templateDefinitionIsInClass(SgTemplateInstantiationMemberFunctionDecl* memberFunctionDeclaration)
 *
 * @brief Determines if a template declaration associated with a member function instantiation is defined in the class or outside of it.
 *
 * This function checks whether the template declaration of a given member function instantiation is defined within the class or not. 
 * It uses the ROSE compiler infrastructure to navigate the AST and check the parent scopes of the template declarations.
 *
 * @param memberFunctionDeclaration A pointer to an SgTemplateInstantiationMemberFunctionDecl object representing the member function instantiation.
 *
 * @return True if the template declaration is defined in the class, false otherwise.
 *
 * @warning This function assumes that the input memberFunctionDeclaration is a valid and non-null pointer. 
 *          If this assumption is not met, undefined behavior may occur.
 *
 * @pre The input memberFunctionDeclaration must be a valid SgTemplateInstantiationMemberFunctionDecl object.
 *
 * @post The return value indicates whether the template declaration is defined in the class or not.
 *
 * @note This function uses an alternative approach to check if the template declaration is defined in the class. 
 *       It first retrieves the parent scope of the template declaration and then checks if it is a class definition.
 *
 */

/**
 * @brief Creates a copy of a given member function.
 *
 * This function creates a deep copy of the given SgTemplateInstantiationMemberFunctionDecl object. 
 * It uses a nondefiningFunctionDeclarationCopy to ensure that only the non-defining declaration is copied, 
 * and not the defining declaration or any other associated declarations.
 *
 * @param n The SgTemplateInstantiationMemberFunctionDecl object to be copied.
 * @return A pointer to the newly created copy of the member function.
 */

/**
 * @fn bool SageInterface::isStructDeclaration(SgNode* node)
 *
 * @brief Checks if a given SgNode represents a struct declaration.
 *
 * This function determines whether the provided SgNode corresponds to a struct declaration in the abstract syntax tree (AST).
 * It utilizes the isSgClassDeclaration() method to verify if the node is indeed a class declaration, 
 * and then checks its type to confirm it's specifically a struct declaration.
 *
 * @param node The SgNode to be checked for being a struct declaration. Must not be NULL.
 *
 * @return True if the node represents a struct declaration; false otherwise.
 *
 * @warning This function does not perform any checks on the validity or consistency of the AST itself.
 *
 * @preconditions The input node must not be NULL and should be part of an existing AST.
 *
 * @postconditions None
 *
 * @note This function relies on the ROSE framework's internal representation of the code as an abstract syntax tree (AST).
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* node = ...; // Assume a valid SgNode instance is obtained here
 *           if (SageInterface::isStructDeclaration(node)) {
 *             cout << "The node represents a struct declaration." << endl;
 *           } else {
 *             cout << "The node does not represent a struct declaration." << endl;
 *           }
 *          @endcode
 */
/**
 * @fn bool SageInterface::isUnionDeclaration(SgNode* node)
 *
 * @brief Checks if a given SgNode represents a union declaration.
 *
 * This function determines whether the provided SgNode corresponds to a union
 * declaration in the source code. It uses the ROSE compiler infrastructure's
 * SgClassDeclaration class and its get_class_type() method to make this
 * determination.
 *
 * @param node The SgNode to be inspected for being a union declaration.
 *             Must not be NULL; otherwise, the function will assert.
 *
 * @return True if the given SgNode represents a union declaration; false otherwise.
 *
 * @warning This function asserts if the input node is NULL. Make sure to pass
 *          a valid non-NULL pointer to this function.
 *
 * @pre The input node must not be NULL.
 *
 * @post None.
 *
 * @note This function relies on the ROSE compiler infrastructure's SgClassDeclaration
 *       class and its get_class_type() method for determining whether an SgNode is a
 *       union declaration. Refer to the ROSE documentation for more information about
 *       these classes and methods.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           // Create an SgNode representing a union declaration
 *           SgClassDeclaration* decl = new SgClassDeclaration(...);
 *           decl->set_class_type(SgClassDeclaration::e_union);
 *
 *           // Check if the node represents a union declaration
 *           bool isUnion = SageInterface::isUnionDeclaration(decl);
 *
 *           // Print the result
 *           std::cout << "Is union declaration: " << (isUnion ? "true" : "false") << std::endl;
 *          @endcode
 */
/**
 * @fn SageInterface::addDefaultConstructorIfRequired(SgClassType* classType, int physical_file_id)
 *
 * @brief Adds a default constructor to a class if it does not have one but has other constructors.
 *
 * This function checks if a given SgClassType has any constructors. If at least one constructor is found,
 * it then checks for the presence of a default constructor (i.e., a constructor with no parameters).
 * If a default constructor is not found, this function generates and adds a default constructor to the class.
 * This is necessary because the compiler will not generate a default constructor if any other constructors are present.
 *
 * @param classType The SgClassType that may need a default constructor added. Must be non-null.
 * @param physical_file_id The file ID associated with the code being modified. Defaults to -1.
 *
 * @return True if a default constructor was successfully added, false otherwise.
 */

/**
 * This function is used to ensure that classes have a default constructor when necessary.
 * It takes into account the presence of other constructors and the compiler's behavior regarding
 * default constructor generation.
 *
 * The process involves first checking for any constructors in the class. If at least one is found,
 * it then checks specifically for a default constructor. If no default constructor is present, this
 * function creates and adds one to the class definition.
 */

/**
 * This function modifies the given SgClassType by adding a default constructor if necessary.
 * The modification involves prepending a newly created default constructor declaration to the class definition.
 * Additionally, it sets the physical file ID of the new constructor and its definition to match the provided physical_file_id parameter.
 */
 
/** 
 * @warning This function modifies the input SgClassType by adding a default constructor if necessary. 
 */

/**
 * @fn void SageInterface::recursivePrintCurrentAndParent (SgNode* n)
 *
 * @brief Recursively prints information about the current node and its parent.
 *
 * This function is designed to traverse the abstract syntax tree (AST) in a recursive manner, 
 * starting from a given node. It displays detailed information about each node, including its 
 * class name, file location (if available), and unparsed string representation. The recursion 
 * continues until it reaches a null node.
 *
 * @param n A pointer to the SgNode object representing the current node in the AST. 
 *          Must not be null for meaningful output; however, the function handles null inputs by returning immediately.
 *
 * @return None
 *
 * @warning This function uses recursive calls and may cause a stack overflow if the AST is very deep.
 *
 * @pre The input node n must be a valid SgNode object within the AST.
 *
 * @post The function will have printed detailed information about each node from the starting node to its root in the AST.
 *
 * @note This function modifies the output stream (cout) directly. If you need to capture or redirect the output, consider using a different approach.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* someNode = ...; // Assume someNode is properly initialized and valid
 *           SageInterface sage;
 *           sage.recursivePrintCurrentAndParent(someNode);
 *          @endcode
 */
/**
 * @fn void SageInterface::saveToPDF(SgNode* node, std::string filename)
 *
 * @brief Saves an SgNode to a PDF file.
 *
 * This function generates a JSON representation of the given SgNode and saves it
 * to a PDF file with the specified filename. The JSON generation is performed using
 * the AstJSONGeneration class.
 *
 * @param node The SgNode to be saved to the PDF file. Must not be NULL.
 * @param filename The name of the PDF file to which the SgNode will be saved.
 *
 * @return None
 *
 * @warning This function does not perform any error checking on the input parameters.
 *          It is the responsibility of the caller to ensure that the node and filename are valid.
 *
 * @pre The node parameter must not be NULL. The filename parameter must be a valid string.
 *
 * @post A PDF file with the specified filename will be created, containing the JSON representation of the SgNode.
 *
 * @note This function uses the AstJSONGeneration class to generate the JSON representation of the SgNode.
 *       The getEnclosingFileNode function is used to determine the enclosing file node for the given SgNode.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SageInterface sage;
 *           SgNode* node = ...; // obtain an SgNode instance
 *           std::string filename = "output.pdf";
 *           sage.saveToPDF(node, filename);
 *          @endcode
 */
/**
 * @fn void SageInterface::saveToPDF(SgNode* node)
 *
 * @brief Saves an Abstract Syntax Tree (AST) to a PDF file.
 *
 * This function initiates the process of saving an AST, rooted at the given SgNode,
 * into a PDF file. It starts by saving the AST into a JSON file, which is then post-processed
 * to generate the final PDF file.
 *
 * @param node The root node of the Abstract Syntax Tree (AST) to be saved.
 *              Must not be NULL.
 *
 * @return None
 *
 * @warning This function may throw an exception if there are errors during the saving process.
 *
 * @pre The input SgNode must be a valid AST node and must not be NULL.
 *
 * @post A JSON file containing the AST data will be generated, which can then be post-processed to create a PDF file.
 *
 * @note This function is part of the SageInterface class and relies on other internal functions for its operation.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* rootNode = ...; // Assume this is a valid AST node
 *           SageInterface sage;
 *           sage.saveToPDF(rootNode);
 *          @endcode
 */
/**
 * @fn void SageInterface::printAST(SgNode* node)
 *
 * @brief Prints the Abstract Syntax Tree (AST) of a given SgNode.
 *
 * This function takes an SgNode as input, serializes it into a string representation,
 * and then prints this string to the standard output. It is used for debugging purposes
 * or for visualizing the AST structure of the source code being analyzed.
 *
 * @param node The SgNode representing the root of the subtree to be printed.
 *              Must not be NULL, and should be a valid SgNode instance.
 *
 * @return None
 *
 * @warning This function may throw exceptions if the input SgNode is invalid or corrupted,
 *          or if there are errors during serialization. It also assumes that the standard
 *          output stream (cout) is properly initialized and functional.
 *
 * @pre The input SgNode must be a valid instance of an SgNode subclass, and should have been
 *      properly initialized before being passed to this function.
 *
 * @post After executing this function, the contents of the input SgNode's AST will have been
 *       printed to the standard output stream (cout).
 *
 * @note This function is primarily intended for debugging purposes. For production use,
 *       consider using a more robust and efficient method for serializing and printing ASTs.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* node = ...; // Initialize an SgNode instance
 *           SageInterface sage;
 *           sage.printAST(node); // Print the AST of the given node
 *          @endcode
 */
/**
 * @fn void SageInterface::printAST(SgNode* node, const char* filename)
 *
 * @brief Prints an Abstract Syntax Tree (AST) to a file.
 *
 * This function takes an SgNode representing the root of the AST and a filename,
 * then prints the AST to the specified file. It utilizes the printAST2TextFile
 * function internally, passing the node, filename, and a boolean flag set to true.
 *
 * @param node The root node of the Abstract Syntax Tree to be printed.
 * @param filename The name of the file where the AST will be printed.
 *
 * @return None. This function does not return any value.
 *
 * @warnings If the file cannot be opened for writing, an error may occur.
 *
 * @preconditions A valid SgNode and a non-empty filename are provided.
 *
 * @postconditions The AST represented by the input node is printed to the specified file.
 *
 * @note This function relies on the implementation of printAST2TextFile for actual printing functionality.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* root = ...; // Assume a valid AST root node
 *           const char* filename = "ast_output.txt";
 *           SageInterface::printAST(root, filename);
 *          @endcode
 */
/**
 * @fn void SageInterface::printAST2TextFile(SgNode* node, const char* filename, bool printType/*=true*/)
 *
 * @brief Prints an Abstract Syntax Tree (AST) to a text file.
 *
 * This function takes an AST represented as an SgNode and prints it to a specified
 * text file. The output includes the serialized representation of the AST nodes,
 * with optional type information appended if requested.
 *
 * The serialization is performed using a recursive approach, traversing the AST
 * and generating a string representation of each node. The resulting string is then
 * written to the specified output file.
 *
 * @param node The root node of the AST to be printed.
 * @param filename The name of the text file where the AST will be printed.
 * @param printType Optional parameter indicating whether type information should be included in the output (default: true).
 *
 * @return None
 *
 * @warning If the specified file cannot be opened for writing, an error may occur.
 *
 * @pre The input node is a valid SgNode representing an AST.
 * @post The contents of the AST have been written to the specified text file.
 *
 * @note This function assumes that the input AST is well-formed and does not contain any cycles.
 *
 */
/**
 * @fn void SageInterface::printAST2TextFile (SgNode* node, std::string filename, bool printType/*=true*/)
 *
 * @brief Prints an Abstract Syntax Tree (AST) to a text file.
 *
 * This function generates a human-readable representation of the AST rooted at
 * the given node and writes it to the specified file. The output includes node
 * types and values, as well as structural relationships between nodes.
 *
 * @param node The root node of the AST to be printed.
 * @param filename The name of the text file where the AST will be written.
 * @param printType If true, include type information in the output. Defaults to true.
 *
 * @return None
 *
 * @warning This function does not perform any error checking on the input node or file name.
 *
 * @pre The input node must be a valid SgNode pointer, and the filename must be a valid string.
 *
 * @post A text file with the specified name will be created in the current working directory,
 *       containing a human-readable representation of the AST rooted at the input node.
 *
 * @note This function uses a recursive algorithm to traverse the AST. If the AST is very large,
 *       this may lead to stack overflow errors.
 *
 */
/**
 * @fn void SageInterface::whereAmI(SgNode* node)
 *
 * @brief Prints diagnostic information about the location of a given SgNode in the AST.
 *
 * This function is used to detect where we are when something fails. It traverses up
 * the AST from the given node, printing out parent nodes and their file information,
 * until it reaches the SgFile level.
 *
 * @param node The SgNode for which to print diagnostic information. Must be a valid non-null pointer.
 *
 * @return None
 *
 * @warning This function does not perform any error checking on the input node, other than asserting that it is non-null and not an SgFile, SgFileList, or SgProject.
 *
 * @pre The input node must be a valid non-null pointer to an SgNode.
 * @post Diagnostic information about the location of the given node will have been printed out.
 *
 * @note This function is intended for debugging purposes only and should not be called in production code.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgNode* node = ...; // obtain a valid non-null pointer to an SgNode
 *           SageInterface::whereAmI(node);
 *          @endcode
 */
/**
 * @fn std::string SageInterface::extractPragmaKeyword(const SgPragmaDeclaration *pragmaDeclaration)
 *
 * @brief Extracts the keyword from a given pragma declaration.
 *
 * This function takes a pragma declaration as input, extracts the associated string,
 * and then parses it to extract the first keyword. The extracted keyword is returned
 * as a std::string object.
 *
 * The function assumes that the input pragma declaration is valid and contains at least one keyword.
 *
 * @param pragmaDeclaration A pointer to an SgPragmaDeclaration object representing the pragma declaration from which to extract the keyword.
 *
 * @return The extracted keyword as a std::string object. If the input pragma declaration does not contain any keywords, an empty string is returned.
 *
 * @warning This function does not perform any error checking on the input pragma declaration. It assumes that the input is valid and properly formed.
 *
 * @pre The input pragma declaration must be non-null and contain at least one keyword.
 *
 * @post The extracted keyword is returned as a std::string object.
 *
 * @note This function uses an istringstream to parse the pragma string and extract the first keyword. It assumes that the keyword is separated from other pragmas by whitespace characters.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgPragmaDeclaration* pragmaDecl = ...; // obtain a valid SgPragmaDeclaration object
 *           std::string keyword = SageInterface::extractPragmaKeyword(pragmaDecl);
 *           cout << "Extracted keyword: " << keyword << endl;
 *          @endcode
 */
/**
 * @fn bool SageInterface::isOmpStatement(SgNode* n)
 *
 * @brief Checks if a given SgNode represents an OpenMP statement.
 *
 * This function verifies whether the provided SgNode corresponds to any of the
 * following OpenMP statements: barrier, body, declare simd, flush, threadprivate,
 * or taskwait. It uses a series of conditional checks to determine this.
 *
 * @param n The SgNode to be checked for being an OpenMP statement.
 *          Must not be NULL.
 *
 * @return True if the provided SgNode represents an OpenMP statement; false otherwise.
 *
 * @warning This function does not perform any additional error checking beyond
 *          what is specified in its parameters. It assumes that the input SgNode
 *          has already been validated.
 *
 * @pre The input SgNode must not be NULL.
 *
 * @post If the function returns true, it guarantees that the provided SgNode represents
 *       an OpenMP statement; otherwise, no such guarantee is made.
 *
 * @note This function uses a recursive algorithm to check for various OpenMP statements.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SageInterface sage;
 *           // assuming 'node' is a valid SgNode
 *           if (sage.isOmpStatement(node)) {
 *             cout << "The node represents an OpenMP statement." << endl;
 *           } else {
 *             cout << "The node does not represent an OpenMP statement." << endl;
 *           }
 *          @endcode
 */
/**
 * @fn SageInterface::isOverloaded(SgFunctionDeclaration* functionDeclaration)
 *
 * @brief Checks if a given function declaration is overloaded.
 *
 * This function checks for any other function that might overload the input function.
 * For member functions, it only looks in the scope where the member function is defined.
 * For non-member functions, it looks only in the scope where the function is declared.
 * Note that there are scenarios where this approach of searching only these locations
 * might not catch an overloaded function. See notes below for details.
 *
 * @param functionDeclaration The input function declaration to be checked for overloading.
 *
 * @return True if the function is overloaded, false otherwise.
 *
 * @warning This function may not detect all cases of overloaded functions due to its limited search scope.
 *          For member functions, it does not check base classes or friend functions in other classes.
 *          For non-member functions, it does not check different namespace definitions or friend functions in classes.
 *
 * @pre The input function declaration is valid and not null.
 *
 * @post None
 *
 * @note This function uses a counter to detect overloaded functions. If more than one function with the same name is found,
 *       it returns true, indicating that the function is overloaded.
 *
 * @note For member functions, this function checks if there are other member functions with the same name in the same class.
 *       It does not check base classes or friend functions in other classes.
 *
 * @note For non-member functions, this function checks if there are other non-member functions with the same name in the same scope.
 *       It does not check different namespace definitions or friend functions in classes.
 *
 * @example
 *   // Create a sample function declaration
 *   SgFunctionDeclaration* funcDecl = ...;
 *
 *   // Check if the function is overloaded
 *   bool isOverloaded = SageInterface::isOverloaded(funcDecl);
 *
 *   // Print the result
 *   std::cout << "Is function overloaded? " << (isOverloaded ? "Yes" : "No") << std::endl;
 */
/**
 * @fn void SageInterface::initializeIfStmt(SgIfStmt *ifstmt, SgStatement* conditional, SgStatement * true_body, SgStatement * false_body)
 *
 * @brief Initializes a SgIfStmt object with the given conditional statement and bodies.
 *
 * This function initializes a SgIfStmt object by setting its conditional statement and 
 * true/false bodies. It also sets the parent of each body to the if-statement and ensures 
 * that the if-statement is case-insensitive if necessary.
 *
 * @param ifstmt The SgIfStmt object to be initialized. Must not be null.
 * @param conditional The conditional statement for the if-statement. If null, it will be set to nullptr.
 * @param true_body The body of the if-statement when the condition is true. If null, it will be set to nullptr.
 * @param false_body The body of the if-statement when the condition is false. If null, it will be set to nullptr.
 *
 * @return None
 *
 * @warning This function assumes that the SgIfStmt object has already been constructed and only needs 
 *          initialization. If the object has not been constructed, undefined behavior may occur.
 *
 * @pre The ifstmt parameter must not be null.
 * @post The SgIfStmt object will have its conditional statement and bodies set to the specified values.
 * @post The parent of each body will be set to the if-statement.
 * @post If the language is case-insensitive, the if-statement will be marked as case-insensitive.
 *
 * @note This function does not perform any checks on the validity of the conditional statement or bodies. 
 *       It assumes that they are valid and correctly constructed.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgIfStmt* ifstmt = new SgIfStmt();
 *           SgStatement* cond = ...; // some condition
 *           SgStatement* trueBody = ...; // body when condition is true
 *           SgStatement* falseBody = ...; // body when condition is false
 *
 *           SageInterface::initializeIfStmt(ifstmt, cond, trueBody, falseBody);
 *          @endcode
 */
/**
 * @fn void SageInterface::initializeSwitchStatement(SgSwitchStatement* switchStatement, SgStatement* item_selector, SgStatement* body)
 *
 * @brief Initializes a switch statement with the given selector and body.
 *
 * This function initializes a switch statement by setting its case insensitivity,
 * item selector, and body. It also sets the parent of the item selector and body
 * to the switch statement if they are not null.
 *
 * The function first checks if the language is case insensitive and sets the
 * switch statement's case insensitivity accordingly. Then it checks if the
 * switch statement has an item selector and a body, and sets them if they are null.
 * Finally, it sets the source position for the transformation and updates the
 * parent pointers of the item selector and body if necessary.
 *
 * @param switchStatement The switch statement to be initialized. Must not be null.
 * @param item_selector The item selector of the switch statement. Can be null.
 * @param body The body of the switch statement. Can be null.
 *
 * @return None
 *
 * @warning This function does not perform any error checking on the input parameters.
 *          It assumes that they are valid and will not cause any errors during execution.
 *
 * @pre The switch statement must not be null.
 * @post The switch statement's case insensitivity, item selector, and body are set according to the input parameters.
 *       The parent pointers of the item selector and body are updated if necessary.
 *
 * @note This function is used internally by the SageInterface class and should not be called directly by users.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgSwitchStatement* switchStatement = ...;
 *           SgStatement* item_selector = ...;
 *           SgStatement* body = ...;
 *           SageInterface::initializeSwitchStatement(switchStatement, item_selector, body);
 *          @endcode
 */
/**
 * @fn void SageInterface::initializeWhileStatement(SgWhileStmt* whileStatement, SgStatement *  condition, SgStatement *body, SgStatement *else_body)
 *
 * @brief Initializes a while statement with the given condition and body.
 *
 * This function initializes a while statement by setting its condition and body,
 * as well as optionally setting an else body if provided. It also sets the
 * parent-child relationships between the statements and ensures case insensitivity
 * if the language requires it.
 *
 * @param whileStatement The while statement to be initialized. Must not be null.
 * @param condition The condition of the while statement. May be null.
 * @param body The body of the while statement. May be null.
 * @param else_body The else body of the while statement, if any. May be null.
 *
 * @return None
 *
 * @warning If the language is case insensitive, this function will set the while
 *          statement to be case insensitive as well.
 *
 * @pre The whileStatement parameter must not be null.
 *
 * @post The condition and body of the while statement will be set if provided,
 *       and the parent-child relationships between the statements will be established.
 *
 * @note This function also supports Python-specific features, such as setting an
 *       else body for the while statement.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgWhileStmt* whileStatement = ...;
 *           SgStatement* condition = ...;
 *           SgStatement* body = ...;
 *           SgStatement* else_body = ...;
 *           SageInterface::initializeWhileStatement(whileStatement, condition, body, else_body);
 *          @endcode
 */
/**
 * @fn void SageInterface::annotateExpressionsWithUniqueNames(SgProject* project)
 *
 * @brief Annotates expressions in an AST with unique names.
 *
 * This function traverses the abstract syntax tree (AST) of a given SgProject and annotates each expression node with a unique name. The unique name is generated based on the expression's class name and other factors to ensure uniqueness within the project.
 *
 * @param project A pointer to an SgProject object representing the AST to be annotated.
 *
 * @return None
 *
 * @warning This function modifies the input AST by adding new attributes to expression nodes. It does not perform any checks for existing annotations or handle potential naming conflicts.
 *
 * @pre The input project must be a valid, non-null pointer to an SgProject object. The project's AST should be properly constructed and contain at least one expression node.
 *
 * @post After executing this function, each expression node in the input project's AST will have a new attribute named "UniqueNameAttribute" containing a unique name generated based on the expression's class name.
 *
 * @note This function uses a recursive traversal approach to visit all nodes in the input AST. It assumes that the input project's AST is well-formed and does not contain any cycles or invalid node references.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject* project = new SgProject();
 *           // Initialize the project with some expressions...
 *           SageInterface::annotateExpressionsWithUniqueNames(project);
 *           // Now, each expression node in the project's AST has a unique name attribute.
 *          @endcode
 */
/**
 * @fn bool SageInterface::isMain(const SgNode* n)
 *
 * @brief Checks if a given node represents the main entry point of a program.
 *
 * This function determines whether a provided SgNode represents the main entry
 * point of a program, considering both C/C++ and Fortran languages. It examines
 * various properties of the node to make this determination, including its type,
 * scope, and name.
 *
 * @param n The SgNode to check for being the main entry point.
 *
 * @return True if the node represents the main entry point, false otherwise.
 *
 * @warning This function assumes that the input node is valid and not null.
 *
 * @pre The input node must be a valid SgNode instance.
 *
 * @post The return value will indicate whether the node represents the main entry
 *       point of a program.
 *
 * @note This function uses language-specific checks to determine if the node
 *       represents the main entry point. For Fortran, it specifically looks for
 *       an SgProgramHeaderStatement, while for other languages (including C/C++
 *       and Java), it checks for an SgFunctionDeclaration with the name "main"
 *       within a global scope.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *             // Create an SgNode representing a main entry point
 *             const SgNode* node = ...;
 *
 *             // Check if the node represents the main entry point
 *             bool isMainEntry = SageInterface::isMain(node);
 *
 *             // Print the result
 *             std::cout << "Is main entry: " << (isMainEntry ? "true" : "false") << std::endl;
 *          @endcode
 */
/**
 * @fn string SageInterface::generateUniqueVariableName(SgScopeStatement* scope, std::string baseName)
 *
 * @brief Generates a unique variable name within a given scope.
 *
 * This function generates a unique variable name by appending a counter value
 * to a base name. It checks for collisions with existing symbols in the parent
 * and child scopes.
 *
 * The implementation uses a recursive approach to handle nested scopes.
 * It also utilizes the `lookupSymbolInParentScopes` and `lookup_symbol` functions
 * from the SageInterface class to perform symbol lookups.
 *
 * @param scope The SgScopeStatement object representing the current scope.
 * @param baseName The base name for the variable, which will be modified to make it unique.
 *
 * @return A string representing the generated unique variable name.
 *
 * @warning This function may generate numbers that are unnecessarily high due
 *          to its implementation.
 *
 * @pre The input `scope` must be a valid SgScopeStatement object.
 * @post The returned variable name is guaranteed to be unique within the given scope.
 *
 * @note This function uses a static counter, which means it may not be thread-safe.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgScopeStatement* scope = ...; // obtain a valid scope object
 *           std::string baseName = "myVariable";
 *           std::string uniqueName = SageInterface::generateUniqueVariableName(scope, baseName);
 *           // use the generated unique name
 *          @endcode
 */
/**
 * @brief Empty function or ill-formed function detected.
 */
/**
 * @fn SageInterface::generateProjectName( const SgProject* project, bool supressSuffix )
 *
 * @brief Generates a unique string to use as a project name for a collection of files.
 *
 * This function takes a project and an optional flag to suppress the suffix in the generation
 * of the project name. It returns a string that can be used as a unique project name,
 * which is useful for avoiding filename collisions when generating names for whole AST graphs.
 *
 * The generated project name includes the last file's suffix, unless supressSuffix is true.
 *
 * @param project A pointer to an SgProject object representing the collection of files.
 *                Must not be NULL. If project is empty (i.e., it contains no files),
 *                the function returns "empty_file_list".
 *
 * @param supressSuffix An optional boolean flag indicating whether to suppress the suffix
 *                      in the generated project name. Default value is false.
 *
 * @return A string representing a unique project name for the given collection of files.
 *
 * @warning The returned string may be empty if the input project is empty or ill-formed.
 *
 * @pre The input project must not be NULL.
 *
 * @post The returned string will be non-empty unless the input project is empty.
 *
 * @note This function uses a recursive algorithm to generate the project name.
 *       It also uses the StringUtility class to strip file suffixes and paths from filenames.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgProject* project = ...; // Initialize project
 *           string projectName = SageInterface::generateProjectName(project);
 *           cout << "Generated project name: " << projectName << endl;
 *          @endcode
 */

/**
 * @fn SgFunctionDeclaration* SageInterface::getDeclarationOfNamedFunction(SgExpression* func)
 *
 * @brief Retrieves the declaration of a named function from a given expression.
 *
 * This function takes an expression as input and attempts to extract the declaration
 * of a named function. It supports various types of expressions, including function references,
 * dot operations, and arrow operations.
 *
 * The function first checks if the input expression is a function reference. If so, it directly
 * returns the declaration of the referenced function.
 *
 * If the input expression is not a function reference, the function checks if it is a dot or arrow
 * operation. In this case, it extracts the right-hand side operand and checks if it is a member
 * function reference. If so, it returns the declaration of the referenced member function.
 *
 * If none of the above conditions are met, the function issues a warning message to the standard error stream
 * indicating that the input expression does not represent a named function.
 *
 * @param func The input expression from which to extract the declaration of a named function.
 *
 * @return A pointer to the declaration of the named function if found; otherwise, NULL.
 *
 * @warning If the right-hand side operand of a dot or arrow operation is not a member function reference,
 *          a warning message is issued to the standard error stream.
 *
 * @pre The input expression must be non-NULL.
 *
 * @post If the function returns a non-NULL pointer, it points to a valid declaration of a named function.
 *
 * @note This function does not perform any semantic analysis on the input expression. It only checks
 *       the syntactic structure of the expression to determine if it represents a named function.
 *
 * @example This example demonstrates how to use this function:
 *          @code
 *           SgExpression* func = ...; // assume some valid expression
 *           SgFunctionDeclaration* decl = SageInterface::getDeclarationOfNamedFunction(func);
 *           if (decl != NULL) {
 *             // process the declaration of the named function
 *           }
 *          @endcode
 */
/**
