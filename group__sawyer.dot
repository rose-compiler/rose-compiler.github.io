  Node4 [id="Node000004",label="Command line value\l augmenter factories",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__sawyer__augmenter__factories.html",tooltip="Factories for creating instances of Sawyer::CommandLine::ValueAugmenter subclasses."];
  Node8 [id="Node000008",label="Class properties",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__sawyer__class__properties.html",tooltip="Data members that that store a simple value."];
  Node6 [id="Node000006",label="Library design goals",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__sawyer__design__goals.html",tooltip="Goals that influence the design of this library."];
  Node9 [id="Node000009",label="Examples",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__sawyer__examples.html",tooltip=" "];
  Node5 [id="Node000005",label="Installation",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__sawyer__installation.html",tooltip="Sawyer can be downloaded from GitHub."];
  Node2 [id="Node000002",label="Command line parser\l factories",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__sawyer__parser__factories.html",tooltip="Factories for creating instances of Sawyer::CommandLine::ValueParser subclasses."];
  Node7 [id="Node000007",label="Reference counting\l smart pointers",height=0.2,width=0.4,color="grey40", fillcolor="white", style="filled",URL="$group__sawyer__smart__pointers.html",tooltip="Pointers that automatically delete the underlying object."];
