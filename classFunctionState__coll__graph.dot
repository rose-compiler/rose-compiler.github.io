  Node1 [id="Node000001",label="FunctionState",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip=" "];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" func",fontcolor="grey" ];
  Node2 [id="Node000002",label="Function",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",URL="$classFunction.html",tooltip=" "];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" decl",fontcolor="grey" ];
  Node3 [id="Node000003",label="SgFunctionDeclaration",height=0.2,width=0.4,color="red", fillcolor="#FFF0F0", style="filled",URL="$classSgFunctionDeclaration.html",tooltip="This class represents the concept of a function declaration statement."];
  Node84 -> Node1 [id="edge3_Node000001_Node000084",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=" retState\nstate",fontcolor="grey" ];
  Node84 [id="Node000084",label="NodeState",height=0.2,width=0.4,color="grey75", fillcolor="white", style="filled",URL="$classNodeState.html",tooltip=" "];
